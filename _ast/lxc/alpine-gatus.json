    "  temp_file=$(mktemp)",
    "  mkdir -p /opt/gatus",
    "  curl -fsSL \"https://github.com/TwiN/gatus/archive/refs/tags/v${RELEASE}.tar.gz\" -o \"$temp_file\"",
