    "  $STD rc-service gatus start",
    "  msg_ok \"Started gatus\"",
    "",
    "  msg_info \"Cleaning up\"",
    "  rm -f \"$temp_file\"",
    "  $STD apk cache clean",
    "  msg_ok \"Cleaned\"",
    "}",
    "",
