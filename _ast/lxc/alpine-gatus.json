    "command_args=\"\"",
    "command_background=\"true\"",
    "command_user=\"root\"",
    "pidfile=\"/var/run/gatus.pid\"",
    "",
    "export GATUS_CONFIG_PATH=\"\"",
    "export GATUS_LOG_LEVEL=\"INFO\"",
    "export PORT=\"8080\"",
    "",
    "depend() {",
    "    use net",
    "}",
