  "source": "#!/usr/bin/env bash\nREPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"\n\n# Copyright (c) 2021-2026 community-scripts ORG\n# Author: Michel Roegl-Brunner (michelroegl-brunner)\n# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE\n# Source: https://checkmk.com/\n\n# shellcheck disable=SC2034\n# Read by the framework - shellcheck cannot see the caller\nAPP=\"checkmk\"\nvar_tags=\"${var_tags:-monitoring}\"\nvar_cpu=\"${var_cpu:-2}\"\nvar_ram=\"${var_ram:-2048}\"\nvar_disk=\"${var_disk:-6}\"\nvar_os=\"${var_os:-debian}\"\nvar_version=\"${var_version:-13}\"\nvar_arm64=\"${var_arm64:-no}\"\nvar_unprivileged=\"${var_unprivileged:-1}\"\n\nfunction install_script() {\n  msg_info \"Installing Dependencies\"\n  ensure_dependencies gpg\n  msg_ok \"Installed Dependencies\"\n\n  local RELEASE\n  RELEASE=$(curl_with_retry \"https://api.github.com/repos/checkmk/checkmk/tags\" \"-\" | grep \"name\" | awk '{print substr($2, 3, length($2)-4) }' | tr ' ' '\\n' | grep -Ev 'rc|b' | sort -V | tail -n 1)\n  RELEASE=\"${RELEASE%%+*}\"\n\n  msg_info \"Installing Checkmk ${RELEASE}\"\n  curl_download \"/opt/checkmk.deb\" \"https://download.checkmk.com/checkmk/${RELEASE}/check-mk-community-${RELEASE}_0.$(get_os_info codename)_amd64.deb\"\n  $STD apt install -y /opt/checkmk.deb\n  rm -rf /opt/checkmk.deb\n  msg_ok \"Installed Checkmk\"\n\n  msg_info \"Creating Monitoring Site\"\n  $STD omd create monitoring\n  $STD omd start monitoring\n  msg_ok \"Created Monitoring Site\"\n}\n\nfunction post_install_script() {\n  msg_ok \"Completed Successfully!\\n\"\n  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"\n  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"\n  echo -e \"${GATEWAY}${BGN}http://${IP}/monitoring${CL}\"\n}\n\nfunction update_script() {\n  header_info\n  check_container_storage\n  check_container_resources\n\n  if ! command -v omd \u0026\u003e /dev/null; then\n    msg_error \"No ${APP} Installation Found!\"\n    exit\n  fi\n\n  local RELEASE\n  RELEASE=$(curl_with_retry \"https://api.github.com/repos/checkmk/checkmk/tags\" \"-\" | grep \"name\" | awk '{print substr($2, 3, length($2)-4) }' | tr ' ' '\\n' | grep -Ev 'rc|b' | sort -V | tail -n 1)\n  RELEASE=\"${RELEASE%%+*}\"\n\n  msg_info \"Updating Checkmk\"\n  $STD omd stop monitoring\n  $STD omd -f rm monitoringbackup 2\u003e /dev/null || true\n  $STD omd cp monitoring monitoringbackup\n  curl_download \"/opt/checkmk.deb\" \"https://download.checkmk.com/checkmk/${RELEASE}/check-mk-community-${RELEASE}_0.$(get_os_info codename)_amd64.deb\"\n  $STD apt install -y /opt/checkmk.deb\n\n  local OMD_VERSION\n  OMD_VERSION=$(omd versions 2\u003e /dev/null | grep \"^${RELEASE}\" | awk '{print $1}')\n  if [[ -z \"${OMD_VERSION}\" ]]; then\n    msg_error \"Could not find installed OMD version for release ${RELEASE}\"\n    exit 1\n  fi\n\n  $STD omd --force -V \"${OMD_VERSION}\" update --conflict=install monitoring\n  $STD omd start monitoring\n  $STD omd -f rm monitoringbackup\n  $STD omd cleanup\n  rm -rf /opt/checkmk.deb\n  msg_ok \"Updated Checkmk\"\n  msg_ok \"Updated successfully!\"\n  exit\n}\n\n# framework bootstrap\n# shellcheck disable=SC1090\n# Dynamic URL resolved at runtime - shellcheck cannot follow\nsource \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")\n",
  "source_lines": [
    "#!/usr/bin/env bash",
    "REPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"",
    "",
    "# Copyright (c) 2021-2026 community-scripts ORG",
    "# Author: Michel Roegl-Brunner (michelroegl-brunner)",
    "# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE",
    "# Source: https://checkmk.com/",
    "",
    "# shellcheck disable=SC2034",
    "# Read by the framework - shellcheck cannot see the caller",
    "APP=\"checkmk\"",
    "var_tags=\"${var_tags:-monitoring}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-2048}\"",
    "var_disk=\"${var_disk:-6}\"",
    "var_os=\"${var_os:-debian}\"",
    "var_version=\"${var_version:-13}\"",
    "var_arm64=\"${var_arm64:-no}\"",
    "var_unprivileged=\"${var_unprivileged:-1}\"",
    "",
    "function install_script() {",
    "  msg_info \"Installing Dependencies\"",
    "  ensure_dependencies gpg",
    "  msg_ok \"Installed Dependencies\"",
    "",
    "  local RELEASE",
    "  RELEASE=$(curl_with_retry \"https://api.github.com/repos/checkmk/checkmk/tags\" \"-\" | grep \"name\" | awk '{print substr($2, 3, length($2)-4) }' | tr ' ' '\\n' | grep -Ev 'rc|b' | sort -V | tail -n 1)",
    "  RELEASE=\"${RELEASE%%+*}\"",
    "",
    "  msg_info \"Installing Checkmk ${RELEASE}\"",
    "  curl_download \"/opt/checkmk.deb\" \"https://download.checkmk.com/checkmk/${RELEASE}/check-mk-community-${RELEASE}_0.$(get_os_info codename)_amd64.deb\"",
    "  $STD apt install -y /opt/checkmk.deb",
    "  rm -rf /opt/checkmk.deb",
    "  msg_ok \"Installed Checkmk\"",
    "",
    "  msg_info \"Creating Monitoring Site\"",
    "  $STD omd create monitoring",
    "  $STD omd start monitoring",
    "  msg_ok \"Created Monitoring Site\"",
    "}",
    "",
    "function post_install_script() {",
    "  msg_ok \"Completed Successfully!\\n\"",
    "  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"",
    "  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"",
    "  echo -e \"${GATEWAY}${BGN}http://${IP}/monitoring${CL}\"",
    "}",
    "",
    "function update_script() {",
    "  header_info",
    "  check_container_storage",
    "  check_container_resources",
    "",
    "  if ! command -v omd \u0026\u003e /dev/null; then",
    "    msg_error \"No ${APP} Installation Found!\"",
    "    exit",
    "  fi",
    "",
    "  local RELEASE",
    "  RELEASE=$(curl_with_retry \"https://api.github.com/repos/checkmk/checkmk/tags\" \"-\" | grep \"name\" | awk '{print substr($2, 3, length($2)-4) }' | tr ' ' '\\n' | grep -Ev 'rc|b' | sort -V | tail -n 1)",
    "  RELEASE=\"${RELEASE%%+*}\"",
    "",
    "  msg_info \"Updating Checkmk\"",
    "  $STD omd stop monitoring",
    "  $STD omd -f rm monitoringbackup 2\u003e /dev/null || true",
    "  $STD omd cp monitoring monitoringbackup",
    "  curl_download \"/opt/checkmk.deb\" \"https://download.checkmk.com/checkmk/${RELEASE}/check-mk-community-${RELEASE}_0.$(get_os_info codename)_amd64.deb\"",
    "  $STD apt install -y /opt/checkmk.deb",
    "",
    "  local OMD_VERSION",
    "  OMD_VERSION=$(omd versions 2\u003e /dev/null | grep \"^${RELEASE}\" | awk '{print $1}')",
    "  if [[ -z \"${OMD_VERSION}\" ]]; then",
    "    msg_error \"Could not find installed OMD version for release ${RELEASE}\"",
    "    exit 1",
    "  fi",
    "",
    "  $STD omd --force -V \"${OMD_VERSION}\" update --conflict=install monitoring",
    "  $STD omd start monitoring",
    "  $STD omd -f rm monitoringbackup",
    "  $STD omd cleanup",
    "  rm -rf /opt/checkmk.deb",
    "  msg_ok \"Updated Checkmk\"",
    "  msg_ok \"Updated successfully!\"",
    "  exit",
    "}",
    "",
    "# framework bootstrap",
    "# shellcheck disable=SC1090",
    "# Dynamic URL resolved at runtime - shellcheck cannot follow",
    "source \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")",
    ""
