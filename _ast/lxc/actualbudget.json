    "Environment=ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20",
    "ExecStart=/usr/bin/actual-server --config /opt/actualbudget-data/config.json",
    "Restart=always",
    "RestartSec=10",
    "",
    "[Install]",
    "WantedBy=multi-user.target",
    "EOF",
