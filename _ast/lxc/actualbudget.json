    "  cat \u003c\u003c EOF \u003e /etc/systemd/system/actualbudget.service",
    "[Unit]",
    "Description=Actual Budget Service",
    "After=network.target",
    "",
    "[Service]",
    "Type=simple",
    "User=root",
    "Group=root",
    "WorkingDirectory=/opt/actualbudget",
