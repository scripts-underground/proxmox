  "source": "#!/usr/bin/env bash\nREPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"\n\n# Sourced by lxc.bootstrap — never executed directly\n# Copyright (c) 2021-2026 community-scripts ORG\n# Author: tteck (tteckster)\n# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE\n# Source: https://www.influxdata.com/\n\n# shellcheck disable=SC2034\nAPP=\"InfluxDB\"\nvar_tags=\"${var_tags:-database;monitoring}\"\nvar_cpu=\"${var_cpu:-2}\"\nvar_ram=\"${var_ram:-2048}\"\nvar_disk=\"${var_disk:-8}\"\nvar_os=\"${var_os:-debian}\"\nvar_version=\"${var_version:-13}\"\nvar_arm64=\"${var_arm64:-yes}\"\nvar_unprivileged=\"${var_unprivileged:-1}\"\n\nfunction install_script() {\n  msg_info \"Setting up InfluxDB Repository\"\n  setup_deb822_repo \\\n    \"influxdb\" \\\n    \"https://repos.influxdata.com/influxdb2.key\" \\\n    \"https://repos.influxdata.com/debian\" \\\n    \"stable\" \\\n    \"main\"\n  msg_ok \"InfluxDB Repository setup successfully\"\n\n  msg_info \"Installing InfluxDB\"\n  $STD apt install -y influxdb2\n  $STD systemctl enable -q --now influxdb\n  msg_ok \"Installed InfluxDB\"\n}\n\nfunction post_install_script() {\n  msg_ok \"Completed Successfully!\\n\"\n  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"\n  echo -e \"${INFO}${YW} Access it using the following URL:${CL}\"\n  echo -e \"${TAB}${GATEWAY}${BGN}http://${IP}:8086${CL}\"\n}\n\nfunction update_script() {\n  header_info\n  check_container_storage\n  check_container_resources\n  if [[ ! -f /usr/bin/influxd ]]; then\n    msg_error \"No ${APP} Installation Found!\"\n    exit\n  fi\n\n  msg_info \"Updating ${APP} LXC\"\n  $STD apt update\n  $STD apt --only-upgrade install -y influxdb2\n  msg_ok \"Updated successfully!\"\n  exit\n}\n\n# framework bootstrap\n# shellcheck disable=SC1090\n# Dynamic URL resolved at runtime - shellcheck cannot follow\nsource \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")\n",
  "source_lines": [
    "#!/usr/bin/env bash",
    "REPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"",
    "",
    "# Sourced by lxc.bootstrap — never executed directly",
    "# Copyright (c) 2021-2026 community-scripts ORG",
    "# Author: tteck (tteckster)",
    "# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE",
    "# Source: https://www.influxdata.com/",
    "",
    "# shellcheck disable=SC2034",
    "APP=\"InfluxDB\"",
    "var_tags=\"${var_tags:-database;monitoring}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-2048}\"",
    "var_disk=\"${var_disk:-8}\"",
    "var_os=\"${var_os:-debian}\"",
    "var_version=\"${var_version:-13}\"",
    "var_arm64=\"${var_arm64:-yes}\"",
    "var_unprivileged=\"${var_unprivileged:-1}\"",
    "",
    "function install_script() {",
    "  msg_info \"Setting up InfluxDB Repository\"",
    "  setup_deb822_repo \\",
    "    \"influxdb\" \\",
    "    \"https://repos.influxdata.com/influxdb2.key\" \\",
    "    \"https://repos.influxdata.com/debian\" \\",
    "    \"stable\" \\",
    "    \"main\"",
    "  msg_ok \"InfluxDB Repository setup successfully\"",
    "",
    "  msg_info \"Installing InfluxDB\"",
    "  $STD apt install -y influxdb2",
    "  $STD systemctl enable -q --now influxdb",
    "  msg_ok \"Installed InfluxDB\"",
    "}",
    "",
    "function post_install_script() {",
    "  msg_ok \"Completed Successfully!\\n\"",
    "  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"",
    "  echo -e \"${INFO}${YW} Access it using the following URL:${CL}\"",
    "  echo -e \"${TAB}${GATEWAY}${BGN}http://${IP}:8086${CL}\"",
    "}",
    "",
    "function update_script() {",
    "  header_info",
    "  check_container_storage",
    "  check_container_resources",
    "  if [[ ! -f /usr/bin/influxd ]]; then",
    "    msg_error \"No ${APP} Installation Found!\"",
    "    exit",
    "  fi",
    "",
    "  msg_info \"Updating ${APP} LXC\"",
    "  $STD apt update",
    "  $STD apt --only-upgrade install -y influxdb2",
    "  msg_ok \"Updated successfully!\"",
    "  exit",
    "}",
    "",
    "# framework bootstrap",
    "# shellcheck disable=SC1090",
    "# Dynamic URL resolved at runtime - shellcheck cannot follow",
    "source \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")",
    ""
