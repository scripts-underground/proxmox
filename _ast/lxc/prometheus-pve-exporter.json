    "  PYTHON_VERSION=\"3.12\" setup_uv",
    "",
    "  msg_info \"Installing Prometheus Proxmox VE Exporter\"",
    "  mkdir -p /opt/prometheus-pve-exporter",
    "  cd /opt/prometheus-pve-exporter || exit",
