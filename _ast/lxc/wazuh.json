    "    sed -i '/\u003c\\/rootcheck\u003e/i \\    \u003cignore\u003e/dev/.lxc\u003c/ignore\u003e' /var/ossec/etc/ossec.conf",
    "    msg_ok \"Added LXC rootcheck exclusion\"",
    "  fi",
    "}",
