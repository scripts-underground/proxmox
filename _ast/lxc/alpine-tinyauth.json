    "APP=\"Alpine-Tinyauth\"",
    "var_tags=\"${var_tags:-alpine;auth}\"",
    "var_cpu=\"${var_cpu:-1}\"",
    "var_ram=\"${var_ram:-256}\"",
    "var_disk=\"${var_disk:-2}\"",
    "var_os=\"${var_os:-alpine}\"",
