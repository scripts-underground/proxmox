    "APP=\"SonarQube\"",
    "var_tags=\"${var_tags:-automation}\"",
    "var_cpu=\"${var_cpu:-4}\"",
    "var_ram=\"${var_ram:-6144}\"",
    "var_disk=\"${var_disk:-25}\"",
