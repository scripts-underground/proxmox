    "# Read by the framework - shellcheck cannot see the caller",
    "APP=\"Alpine-TeamSpeak-Server\"",
    "var_tags=\"${var_tags:-alpine;communication}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-1024}\"",
    "var_disk=\"${var_disk:-8}\"",
    "var_os=\"${var_os:-alpine}\"",
    "var_version=\"${var_version:-3.23}\"",
