  "source": "#!/usr/bin/env bash\nREPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"\n\n# Copyright (c) 2021-2026 community-scripts ORG\n# Author: tteck (tteckster)\n# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE\n# Source: https://emby.media/ | Github: https://github.com/MediaBrowser/Emby.Releases\n\n# shellcheck disable=SC2034\n# Read by the framework - shellcheck cannot see the caller\nAPP=\"Emby\"\nvar_tags=\"${var_tags:-media}\"\nvar_cpu=\"${var_cpu:-2}\"\nvar_ram=\"${var_ram:-2048}\"\nvar_disk=\"${var_disk:-8}\"\nvar_os=\"${var_os:-ubuntu}\"\nvar_version=\"${var_version:-24.04}\"\nvar_arm64=\"${var_arm64:-yes}\"\nvar_unprivileged=\"${var_unprivileged:-1}\"\nvar_gpu=\"${var_gpu:-yes}\"\n\nfunction install_script() {\n  fetch_and_deploy_gh_release \"emby\" \"MediaBrowser/Emby.Releases\" \"binary\"\n\n  setup_hwaccel \"emby\"\n}\n\nfunction post_install_script() {\n  msg_ok \"Completed Successfully!\\n\"\n  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"\n  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"\n  echo -e \"${GATEWAY}${BGN}http://${IP}:8096${CL}\"\n}\n\nfunction update_script() {\n  header_info\n  check_container_storage\n  check_container_resources\n\n  if [[ ! -d /opt/emby-server ]]; then\n    msg_error \"No ${APP} Installation Found!\"\n    exit\n  fi\n  if check_for_gh_release \"emby\" \"MediaBrowser/Emby.Releases\"; then\n    msg_info \"Stopping Service\"\n    systemctl stop emby-server\n    msg_ok \"Stopped Service\"\n\n    fetch_and_deploy_gh_release \"emby\" \"MediaBrowser/Emby.Releases\" \"binary\"\n\n    msg_info \"Starting Service\"\n    systemctl start emby-server\n    msg_ok \"Started Service\"\n    msg_ok \"Updated successfully!\"\n  fi\n  exit\n}\n\n# framework bootstrap\n# shellcheck disable=SC1090\n# Dynamic URL resolved at runtime - shellcheck cannot follow\nsource \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")\n",
  "source_lines": [
    "#!/usr/bin/env bash",
    "REPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"",
    "",
    "# Copyright (c) 2021-2026 community-scripts ORG",
    "# Author: tteck (tteckster)",
    "# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE",
    "# Source: https://emby.media/ | Github: https://github.com/MediaBrowser/Emby.Releases",
    "",
    "# shellcheck disable=SC2034",
    "# Read by the framework - shellcheck cannot see the caller",
    "APP=\"Emby\"",
    "var_tags=\"${var_tags:-media}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-2048}\"",
    "var_disk=\"${var_disk:-8}\"",
    "var_os=\"${var_os:-ubuntu}\"",
    "var_version=\"${var_version:-24.04}\"",
    "var_arm64=\"${var_arm64:-yes}\"",
    "var_unprivileged=\"${var_unprivileged:-1}\"",
    "var_gpu=\"${var_gpu:-yes}\"",
    "",
    "function install_script() {",
    "  fetch_and_deploy_gh_release \"emby\" \"MediaBrowser/Emby.Releases\" \"binary\"",
    "",
    "  setup_hwaccel \"emby\"",
    "}",
    "",
    "function post_install_script() {",
    "  msg_ok \"Completed Successfully!\\n\"",
    "  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"",
    "  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"",
    "  echo -e \"${GATEWAY}${BGN}http://${IP}:8096${CL}\"",
    "}",
    "",
    "function update_script() {",
    "  header_info",
    "  check_container_storage",
    "  check_container_resources",
    "",
    "  if [[ ! -d /opt/emby-server ]]; then",
    "    msg_error \"No ${APP} Installation Found!\"",
    "    exit",
    "  fi",
    "  if check_for_gh_release \"emby\" \"MediaBrowser/Emby.Releases\"; then",
    "    msg_info \"Stopping Service\"",
    "    systemctl stop emby-server",
    "    msg_ok \"Stopped Service\"",
    "",
    "    fetch_and_deploy_gh_release \"emby\" \"MediaBrowser/Emby.Releases\" \"binary\"",
    "",
    "    msg_info \"Starting Service\"",
    "    systemctl start emby-server",
    "    msg_ok \"Started Service\"",
    "    msg_ok \"Updated successfully!\"",
    "  fi",
    "  exit",
    "}",
    "",
    "# framework bootstrap",
    "# shellcheck disable=SC1090",
    "# Dynamic URL resolved at runtime - shellcheck cannot follow",
    "source \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")",
    ""
