    "var_tags=\"${var_tags:-alpine;database}\"",
    "var_cpu=\"${var_cpu:-1}\"",
    "var_ram=\"${var_ram:-256}\"",
    "var_disk=\"${var_disk:-1}\"",
    "var_os=\"${var_os:-alpine}\"",
