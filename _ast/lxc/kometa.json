    "# shellcheck disable=SC2034",
    "APP=\"Kometa\"",
    "var_tags=\"${var_tags:-media;streaming}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-4096}\"",
    "var_disk=\"${var_disk:-8}\"",
    "var_os=\"${var_os:-debian}\"",
