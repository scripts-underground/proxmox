  "source": "#!/usr/bin/env bash\nREPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"\n\n# Sourced by lxc.bootstrap — never executed directly\n# Copyright (c) 2021-2026 community-scripts ORG\n# Author: tteck (tteckster)\n# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE\n# Source: https://www.proxmox.com/en/proxmox-backup-server\n\n# shellcheck disable=SC2034\n# Read by the framework - shellcheck cannot see the caller\nAPP=\"Proxmox-Backup-Server\"\nvar_tags=\"${var_tags:-backup}\"\nvar_cpu=\"${var_cpu:-2}\"\nvar_ram=\"${var_ram:-2048}\"\nvar_disk=\"${var_disk:-10}\"\nvar_os=\"${var_os:-debian}\"\nvar_version=\"${var_version:-13}\"\nvar_arm64=\"${var_arm64:-yes}\"\nvar_unprivileged=\"${var_unprivileged:-1}\"\n\nfunction install_script() {\n  export DEBIAN_FRONTEND=noninteractive\n  export IFUPDOWN2_NO_IFRELOAD=1\n\n  if [[ \"$(get_system_arch)\" == \"arm64\" ]]; then\n    msg_info \"Installing Proxmox Backup Server (unofficial arm64 build)\"\n    PBS_TMP=$(mktemp -d)\n    github_api_call \"https://api.github.com/repos/wofferl/proxmox-backup-arm64/releases/latest\" \"$PBS_TMP/release.json\"\n    cd \"$PBS_TMP\" || exit\n    for url in $(jq -r '.assets[].browser_download_url\n      | select(endswith(\".deb\"))\n      | select(test(\"dbgsym|client-static|file-restore\") | not)' \"$PBS_TMP/release.json\"); do\n      curl_with_retry \"$url\" \"$(basename \"$url\")\"\n    done\n    $STD apt install -y ./*.deb\n    rm -rf \"$PBS_TMP\"\n  else\n    msg_info \"Installing Proxmox Backup Server\"\n    setup_deb822_repo \\\n      \"proxmox-backup-server\" \\\n      \"https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg\" \\\n      \"http://download.proxmox.com/debian/pbs\" \\\n      \"trixie\" \\\n      \"pbs-no-subscription\"\n    $STD apt install -y proxmox-backup-server\n  fi\n  msg_ok \"Installed Proxmox Backup Server\"\n}\n\nfunction post_install_script() {\n  msg_ok \"Completed successfully!\\n\"\n  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"\n  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"\n  echo -e \"${TAB}${GATEWAY}${BGN}https://${IP}:8007${CL}\"\n}\n\nfunction update_script() {\n  header_info\n  check_container_storage\n  check_container_resources\n  if [[ ! -e /usr/sbin/proxmox-backup-manager ]]; then\n    msg_error \"No ${APP} Installation Found!\"\n    exit\n  fi\n  msg_info \"Updating $APP LXC\"\n  $STD apt update\n  $STD apt -y upgrade\n  msg_ok \"Updated $APP LXC\"\n  msg_ok \"Updated successfully!\"\n  exit\n}\n\n# framework bootstrap\n# shellcheck disable=SC1090\n# Dynamic URL resolved at runtime - shellcheck cannot follow\nsource \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")\n",
  "source_lines": [
    "#!/usr/bin/env bash",
    "REPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"",
    "",
    "# Sourced by lxc.bootstrap — never executed directly",
    "# Copyright (c) 2021-2026 community-scripts ORG",
    "# Author: tteck (tteckster)",
    "# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE",
    "# Source: https://www.proxmox.com/en/proxmox-backup-server",
    "",
    "# shellcheck disable=SC2034",
    "# Read by the framework - shellcheck cannot see the caller",
    "APP=\"Proxmox-Backup-Server\"",
    "var_tags=\"${var_tags:-backup}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-2048}\"",
    "var_disk=\"${var_disk:-10}\"",
    "var_os=\"${var_os:-debian}\"",
    "var_version=\"${var_version:-13}\"",
    "var_arm64=\"${var_arm64:-yes}\"",
    "var_unprivileged=\"${var_unprivileged:-1}\"",
    "",
    "function install_script() {",
    "  export DEBIAN_FRONTEND=noninteractive",
    "  export IFUPDOWN2_NO_IFRELOAD=1",
    "",
    "  if [[ \"$(get_system_arch)\" == \"arm64\" ]]; then",
    "    msg_info \"Installing Proxmox Backup Server (unofficial arm64 build)\"",
    "    PBS_TMP=$(mktemp -d)",
    "    github_api_call \"https://api.github.com/repos/wofferl/proxmox-backup-arm64/releases/latest\" \"$PBS_TMP/release.json\"",
    "    cd \"$PBS_TMP\" || exit",
    "    for url in $(jq -r '.assets[].browser_download_url",
    "      | select(endswith(\".deb\"))",
    "      | select(test(\"dbgsym|client-static|file-restore\") | not)' \"$PBS_TMP/release.json\"); do",
    "      curl_with_retry \"$url\" \"$(basename \"$url\")\"",
    "    done",
    "    $STD apt install -y ./*.deb",
    "    rm -rf \"$PBS_TMP\"",
    "  else",
    "    msg_info \"Installing Proxmox Backup Server\"",
    "    setup_deb822_repo \\",
    "      \"proxmox-backup-server\" \\",
    "      \"https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg\" \\",
    "      \"http://download.proxmox.com/debian/pbs\" \\",
    "      \"trixie\" \\",
    "      \"pbs-no-subscription\"",
    "    $STD apt install -y proxmox-backup-server",
    "  fi",
    "  msg_ok \"Installed Proxmox Backup Server\"",
    "}",
    "",
    "function post_install_script() {",
    "  msg_ok \"Completed successfully!\\n\"",
    "  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"",
    "  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"",
    "  echo -e \"${TAB}${GATEWAY}${BGN}https://${IP}:8007${CL}\"",
    "}",
    "",
    "function update_script() {",
    "  header_info",
    "  check_container_storage",
    "  check_container_resources",
    "  if [[ ! -e /usr/sbin/proxmox-backup-manager ]]; then",
    "    msg_error \"No ${APP} Installation Found!\"",
    "    exit",
    "  fi",
    "  msg_info \"Updating $APP LXC\"",
    "  $STD apt update",
    "  $STD apt -y upgrade",
    "  msg_ok \"Updated $APP LXC\"",
    "  msg_ok \"Updated successfully!\"",
    "  exit",
    "}",
    "",
    "# framework bootstrap",
    "# shellcheck disable=SC1090",
    "# Dynamic URL resolved at runtime - shellcheck cannot follow",
    "source \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")",
    ""
