  "source": "#!/usr/bin/env bash\nREPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"\n\n# Copyright (c) 2021-2026 community-scripts ORG\n# Author: tteck (tteckster)\n# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE\n# Source: https://fhem.de/\n\n# shellcheck disable=SC2034\nAPP=\"FHEM\"\nvar_tags=\"${var_tags:-automation}\"\nvar_cpu=\"${var_cpu:-2}\"\nvar_ram=\"${var_ram:-2048}\"\nvar_disk=\"${var_disk:-8}\"\nvar_os=\"${var_os:-debian}\"\nvar_version=\"${var_version:-13}\"\nvar_arm64=\"${var_arm64:-yes}\"\nvar_unprivileged=\"${var_unprivileged:-1}\"\n\nfunction install_script() {\n  msg_info \"Installing Dependencies\"\n  $STD apt install -y avahi-daemon\n  msg_ok \"Installed Dependencies\"\n\n  msg_info \"Setting up FHEM Repository\"\n  setup_deb822_repo \\\n    \"fhem\" \\\n    \"https://debian.fhem.de/archive.key\" \\\n    \"https://debian.fhem.de/nightly/\" \\\n    \"/\"\n  msg_ok \"Set up FHEM Repository\"\n\n  msg_info \"Installing FHEM\"\n  $STD apt install -y fhem\n  systemctl enable -q --now fhem\n  msg_ok \"Installed FHEM\"\n}\n\nfunction post_install_script() {\n  msg_ok \"Completed Successfully!\\n\"\n  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"\n  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"\n  echo -e \"${GATEWAY}${BGN}http://${IP}:8083${CL}\"\n}\n\nfunction update_script() {\n  header_info\n  check_container_storage\n  check_container_resources\n  if [[ ! -f /etc/systemd/system/fhem.service ]]; then\n    msg_error \"No ${APP} Installation Found!\"\n    exit\n  fi\n\n  msg_info \"Updating FHEM\"\n  $STD apt update\n  $STD apt --only-upgrade install -y fhem\n  msg_ok \"Updated FHEM\"\n  msg_ok \"Updated successfully!\"\n  exit\n}\n\n# framework bootstrap\n# shellcheck disable=SC1090\nsource \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")\n",
  "source_lines": [
    "#!/usr/bin/env bash",
    "REPO_BASE=\"${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}\"",
    "",
    "# Copyright (c) 2021-2026 community-scripts ORG",
    "# Author: tteck (tteckster)",
    "# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE",
    "# Source: https://fhem.de/",
    "",
    "# shellcheck disable=SC2034",
    "APP=\"FHEM\"",
    "var_tags=\"${var_tags:-automation}\"",
    "var_cpu=\"${var_cpu:-2}\"",
    "var_ram=\"${var_ram:-2048}\"",
    "var_disk=\"${var_disk:-8}\"",
    "var_os=\"${var_os:-debian}\"",
    "var_version=\"${var_version:-13}\"",
    "var_arm64=\"${var_arm64:-yes}\"",
    "var_unprivileged=\"${var_unprivileged:-1}\"",
    "",
    "function install_script() {",
    "  msg_info \"Installing Dependencies\"",
    "  $STD apt install -y avahi-daemon",
    "  msg_ok \"Installed Dependencies\"",
    "",
    "  msg_info \"Setting up FHEM Repository\"",
    "  setup_deb822_repo \\",
    "    \"fhem\" \\",
    "    \"https://debian.fhem.de/archive.key\" \\",
    "    \"https://debian.fhem.de/nightly/\" \\",
    "    \"/\"",
    "  msg_ok \"Set up FHEM Repository\"",
    "",
    "  msg_info \"Installing FHEM\"",
    "  $STD apt install -y fhem",
    "  systemctl enable -q --now fhem",
    "  msg_ok \"Installed FHEM\"",
    "}",
    "",
    "function post_install_script() {",
    "  msg_ok \"Completed Successfully!\\n\"",
    "  echo -e \"${CREATING}${GN}${APP} setup has been successfully initialized!${CL}\"",
    "  echo -e \"${INFO}${YW}Access it using the following URL:${CL}\"",
    "  echo -e \"${GATEWAY}${BGN}http://${IP}:8083${CL}\"",
    "}",
    "",
    "function update_script() {",
    "  header_info",
    "  check_container_storage",
    "  check_container_resources",
    "  if [[ ! -f /etc/systemd/system/fhem.service ]]; then",
    "    msg_error \"No ${APP} Installation Found!\"",
    "    exit",
    "  fi",
    "",
    "  msg_info \"Updating FHEM\"",
    "  $STD apt update",
    "  $STD apt --only-upgrade install -y fhem",
    "  msg_ok \"Updated FHEM\"",
    "  msg_ok \"Updated successfully!\"",
    "  exit",
    "}",
    "",
    "# framework bootstrap",
    "# shellcheck disable=SC1090",
    "source \u003c(curl -fsSL \"$REPO_BASE/misc/bootstrap/lxc\")",
    ""
