#!/usr/bin/env bash
# GitHub-specific helper functions for scripts-underground.
# Copyright (c) 2026 scripts-underground.org

# ------------------------------------------------------------------------------
# clone_and_deploy_gh_commit — clone a GitHub repo and optionally checkout
# a specific branch or commit. Uses the same owner/repo convention as
# fetch_and_deploy_gh_release.
#
# Usage:
#   clone_and_deploy_gh_commit "owner/repo" "main" "" "/opt/app"
#   clone_and_deploy_gh_commit "$var_git_repo" "$var_git_branch" "$var_pinned_commit" "/opt/odysseus"
#
# Parameters:
#   $1 - repo       (owner/repo, e.g. "pewdiepie-archdaemon/odysseus")
#   $2 - branch     (default: "main")
#   $3 - commit     (optional: if set, checkout this commit instead of branch)
#   $4 - target     (default: /opt/<repo-name>)
# ------------------------------------------------------------------------------
clone_and_deploy_gh_commit() {
  local repo="$1"
  local branch="${2:-main}"
  local commit="${3:-}"
  local target="${4:-/opt/${repo##*/}}"

  $STD git clone "https://github.com/$repo.git" "$target"
  if [[ -n "$commit" ]]; then
    $STD git -C "$target" checkout "$commit"
  elif [[ "$branch" != "main" ]]; then
    $STD git -C "$target" checkout "$branch"
  fi
}
