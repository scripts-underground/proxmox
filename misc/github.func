#!/usr/bin/env bash
# GitHub-specific helper functions for scripts-underground.
# Copyright (c) 2026 scripts-underground.org

# ------------------------------------------------------------------------------
# clone_and_deploy_gh_commit — clone a GitHub repo and optionally checkout
# a specific commit, tag, or branch. Tracks the checked-out ref in ~/.<app>
# so update_script can detect the current mode and switch between
# pinned commits, tags, or branch followers.
#
# Priority: commit > tag > branch.
#
# Usage:
#   clone_and_deploy_gh_commit "myapp" "owner/repo" "main" "" "" "/opt/myapp"
#   clone_and_deploy_gh_commit "$app" "$repo" "$branch" "$tag" "$commit" "$target"
#
# Parameters (positional parity with fetch_and_deploy_gh_release):
#   $1 - app     (name, used for tracking file ~/.<app>)
#   $2 - repo    (owner/repo, e.g. "odysseus-dev/odysseus")
#   $3 - branch  (default: "main")
#   $4 - tag     (optional: git tag, e.g. "v1.0.2")
#   $5 - commit  (optional: commit hash — trumps tag and branch)
#   $6 - target  (default: /opt/<app>)
# ------------------------------------------------------------------------------
clone_and_deploy_gh_commit() {
  local app="$1"
  local repo="$2"
  local branch="${3:-main}"
  local tag="${4:-}"
  local commit="${5:-}"
  local target="${6:-/opt/$app}"
  local app_lc
  app_lc=$(echo "${app,,}" | tr -d ' ')
  local track_file="$HOME/.${app_lc}"

  $STD git clone "https://github.com/$repo.git" "$target"
  if [[ -n "$commit" ]]; then
    $STD git -C "$target" checkout "$commit"
    echo "commit:$commit" > "$track_file"
  elif [[ -n "$tag" ]]; then
    $STD git -C "$target" checkout "tags/$tag"
    echo "tag:$tag" > "$track_file"
  else
    $STD git -C "$target" checkout "$branch"
    echo "branch:$branch" > "$track_file"
  fi
}
