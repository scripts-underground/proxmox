#!/usr/bin/env bash
# GitHub-specific helper functions for scripts-underground.
# Copyright (c) 2026 scripts-underground.org

# ------------------------------------------------------------------------------
# clone_and_deploy_gh_commit — shallow-clone a GitHub repo and optionally
# checkout a specific commit, tag, or branch.  All clones are depth-1 to
# avoid pulling full history into the container.
# Tracks the checked-out ref in ~/.<app> so update_script can detect the
# current mode and switch between pinned commits, tags, or branch followers.
#
# Priority: commit > tag > branch.
#
# Usage:
#   clone_and_deploy_gh_commit "myapp" "owner/repo" "main" "" "" "/opt/myapp"
#   clone_and_deploy_gh_commit "$app" "$repo" "$branch" "$tag" "$commit" "$target"
#
# Parameters (positional parity with fetch_and_deploy_gh_release):
#   $1 - app     (name, used for tracking file ~/.<app>)
#   $2 - repo    (owner/repo, e.g. "odysseus-dev/odysseus")
#   $3 - branch  (default: "main")
#   $4 - tag     (optional: git tag, e.g. "v1.0.2")
#   $5 - commit  (optional: commit hash — trumps tag and branch)
#   $6 - target  (default: /opt/<app>)
# ------------------------------------------------------------------------------
clone_and_deploy_gh_commit() {
  local app="$1"
  local repo="$2"
  local branch="${3:-main}"
  local tag="${4:-}"
  local commit="${5:-}"
  local target="${6:-/opt/$app}"
  local app_lc
  app_lc=$(echo "${app,,}" | tr -d ' ')
  local track_file="$HOME/.${app_lc}"

  _git_deploy_checkout "https://github.com/$repo.git" "$branch" "$tag" "$commit" "$target" || return $?
  local selected="branch:$branch"
  [[ -z "$tag" ]] || selected="tag:$tag"
  [[ -z "$commit" ]] || selected="commit:$commit"
  printf '%s\n' "$selected" > "$track_file"
}

# Complete the remote checkout before the persistence-aware publication owner
# sees it. Every producer is checked even when the public API is conditional.
_git_deploy_checkout() {
  local remote="$1" branch="$2" tag="$3" commit="$4" target="$5" stage rc=0 cleanup_rc=0
  local -a args=(--depth 1 --branch "${tag:-$branch}")
  [[ -z "$commit" ]] || args=(--branch "$branch")
  stage=$(_tools_stage_dir git-checkout) || return $?
  $STD git clone "${args[@]}" -- "$remote" "$stage/repo" || rc=$?
  if [[ $rc == 0 && -n "$commit" ]]; then
    $STD git -C "$stage/repo" checkout "$commit" || rc=$?
  fi
  if [[ $rc == 0 ]]; then
    _deploy_replace_contents "$stage/repo" "$target" "${CLEAN_INSTALL:-0}" || rc=$?
  fi
  _deploy_remove_owned_trees "$stage" || cleanup_rc=$?
  [[ $rc != 0 ]] || rc=$cleanup_rc
  return "$rc"
}

# ------------------------------------------------------------------------------
# git_update_checkout — shallow-safe checkout for update flows.
#
# Use in update_script: replaces raw git checkout / git pull for each mode
# so pin bumps (commit) and tag upgrades work under shallow clone repos.
#
# Usage:
#   git_update_checkout /opt/<app> "$DESIRED_MODE" "$DESIRED_REF"
# ------------------------------------------------------------------------------
git_update_checkout() {
  local dir="$1" mode="$2" ref="$3"
  case "$mode" in
    branch)
      if [[ "${CLEAN_INSTALL:-0}" == 1 ]]; then
        local remote
        remote=$(git -C "$dir" remote get-url origin) || return $?
        _git_deploy_checkout "$remote" "$ref" '' '' "$dir" || return $?
      else
        $STD git -C "$dir" pull origin "$ref" || return $?
      fi
      ;;
    tag)
      $STD git -C "$dir" fetch --depth 1 origin tag "$ref" || return $?
      $STD git -C "$dir" checkout "tags/$ref" || return $?
      ;;
    commit)
      $STD git -C "$dir" fetch origin || return $?
      $STD git -C "$dir" checkout "$ref" || return $?
      ;;
    *) return 65 ;;
  esac
}
