#!/usr/bin/env bash
# bundle.func - Self-contained bundle generation for guest-side execution
# License: MIT | https://raw.githubusercontent.com/scripts-underground/proxmox/main/LICENSE

# ------------------------------------------------------------------------------
# _framework_cache_ensure()
#
# Ensures the LXC profile's framework files are cached on the host at
# ${TMPDIR:-/tmp}/framework-$SESSION_ID/. Fetches once per selected root/session.
# Verifies size (> 100 bytes) and sentinel function presence.
# ------------------------------------------------------------------------------
_framework_cache_dir() {
  printf '%s/framework-%s\n' "${TMPDIR:-/tmp}" "$SESSION_ID"
}

# Explicit receiver paths are lexical, absolute and non-root. Physical path
# validation belongs to the receiver, never to the creator's filesystem.
# The receiving-context owner is one canonical body in POSIX shell syntax: the
# same emitted text runs in Bash, dash and Alpine's BusyBox ash.
_validate_lxc_tmpdir() (
  [ -n "$1" ] || exit 0
  nl='
'
  cr=$(printf '\r')
  tab=$(printf '\t')
  case "$1" in
    /*) ;;
    *)
      printf 'Invalid receiving temporary directory: expected an absolute non-root normalized path\n' >&2
      exit 65
      ;;
  esac
  case "$1/" in
    / | // | *//* | */./* | */../*)
      printf 'Invalid receiving temporary directory: expected an absolute non-root normalized path\n' >&2
      exit 65
      ;;
  esac
  case "$1" in
    *"$nl"* | *"$cr"* | *"$tab"*)
      printf 'Invalid receiving temporary directory: expected an absolute non-root normalized path\n' >&2
      exit 65
      ;;
  esac
)

# Walks in a subshell so no walking variable reaches the caller.
_prepare_lxc_tmpdir_path() (
  # Inspect the complete existing prefix before creating anything. test -L also
  # detects dangling symlinks; no GNU realpath options are required on Alpine.
  remaining=${1#/}
  path=
  while [ -n "$remaining" ]; do
    component=${remaining%%/*}
    path=$path/$component
    if [ -L "$path" ]; then
      printf 'Invalid receiving temporary directory: use its canonical non-symlink path\n' >&2
      exit 65
    fi
    case "$remaining" in
      */*) remaining=${remaining#*/} ;;
      *) remaining= ;;
    esac
  done
  remaining=${1#/}
  path=
  while [ -n "$remaining" ]; do
    component=${remaining%%/*}
    path=$path/$component
    # Only the selected leaf is shared. New parents must not let app users
    # replace a removed leaf; existing administrator metadata is untouched.
    mode=0755
    case "$remaining" in
      */*) ;;
      *) mode=1777 ;;
    esac
    if [ ! -d "$path" ]; then mkdir -m "$mode" -- "$path" || exit $?; fi
    case "$remaining" in
      */*) remaining=${remaining#*/} ;;
      *) remaining= ;;
    esac
  done
)

_prepare_lxc_tmpdir() {
  _validate_lxc_tmpdir "$1" || return $?
  [ -n "$1" ] || return 0
  _prepare_lxc_tmpdir_path "$1" || return $?
  TMPDIR=$1
  export TMPDIR
}

# Checked single-source emitter for the receiving-context closure: bundles and
# creator-side receiver commands transport exactly these definitions.
_receiving_context_contents() {
  declare -f _validate_lxc_tmpdir _prepare_lxc_tmpdir_path _prepare_lxc_tmpdir
}

# Addons stay on the caller's CT filesystem. Unlike LXC transport, a legitimate
# inherited TMPDIR remains meaningful; a saved explicit choice takes priority.
_prepare_addon_context() {
  _prepare_lxc_tmpdir "${var_addon_tmpdir:-${TMPDIR:-}}"
}

# One execution-environment owner for both frozen bundle profiles. Do not bake a
# creator's HOME or invent XDG/session state for a root maintenance command.
_bundle_execution_environment() {
  export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
  export HOME="${HOME:-/root}" USER="${USER:-root}" LOGNAME="${LOGNAME:-root}"
}

_bundle_runtime_header() {
  case "$1" in lxc | addon) ;; *) return 65 ;; esac
  cat << 'HEADER' || return $?
#!/usr/bin/env bash
set -euo pipefail
HEADER
  declare -f _bundle_execution_environment || return $?
  printf '%s\n' '_bundle_execution_environment' || return $?
  if [[ "$1" == lxc ]]; then printf '%s\n' 'unset TMPDIR' || return $?; fi
}

# Decode only the canonical scalar format emitted by Bash printf %q. No shell
# evaluator, command substitution, parameter expansion or old code is executed.
# Re-encoding rejects alternate shell syntax and malformed/ambiguous encodings.
_bundle_scalar_decode() {
  local _bsd_out=$1 _bsd_token=$2 _bsd_value='' _bsd_body _bsd_char _bsd_escape _bsd_piece _bsd_canonical
  if [[ "$_bsd_token" == "''" ]]; then
    _bsd_value=''
  elif [[ "$_bsd_token" == \$\'*\' ]]; then
    _bsd_body=${_bsd_token:2:${#_bsd_token}-3}
    while [[ -n "$_bsd_body" ]]; do
      _bsd_char=${_bsd_body:0:1}
      _bsd_body=${_bsd_body:1}
      if [[ "$_bsd_char" != '\' ]]; then
        _bsd_value+=$_bsd_char
        continue
      fi
      [[ -n "$_bsd_body" ]] || return 65
      _bsd_escape=${_bsd_body:0:1}
      _bsd_body=${_bsd_body:1}
      case "$_bsd_escape" in
        "'" | '\') _bsd_value+=$_bsd_escape ;;
        a | b | e | E | f | n | r | t | v)
          printf -v _bsd_piece '%b' "\\$_bsd_escape" || return $?
          _bsd_value+=$_bsd_piece
          ;;
        [0-7])
          [[ "$_bsd_body" =~ ^[0-7]{2} ]] || return 65
          _bsd_escape+=${_bsd_body:0:2}
          _bsd_body=${_bsd_body:2}
          [[ "$_bsd_escape" != 000 ]] || return 65
          printf -v _bsd_piece '%b' "\\0$_bsd_escape" || return $?
          _bsd_value+=$_bsd_piece
          ;;
        *) return 65 ;;
      esac
    done
  else
    _bsd_body=$_bsd_token
    while [[ -n "$_bsd_body" ]]; do
      _bsd_char=${_bsd_body:0:1}
      _bsd_body=${_bsd_body:1}
      if [[ "$_bsd_char" == '\' ]]; then
        [[ -n "$_bsd_body" ]] || return 65
        _bsd_char=${_bsd_body:0:1}
        _bsd_body=${_bsd_body:1}
      fi
      _bsd_value+=$_bsd_char
    done
  fi
  printf -v _bsd_canonical '%q' "$_bsd_value" || return $?
  if [[ "$_bsd_canonical" != "$_bsd_token" ]]; then
    LC_ALL=C printf -v _bsd_canonical '%q' "$_bsd_value" || return $?
    [[ "$_bsd_canonical" == "$_bsd_token" ]] || return 65
  fi
  printf -v "$_bsd_out" '%s' "$_bsd_value"
}

# Creator side: lexical check, then the canonical preparer in the CT's /bin/sh
# (the root is a positional argument, never shell text). Selects the root for
# _receiving_exec only after preparation succeeded; an empty override selects none.
_prepare_receiving_context() {
  local receiving_context
  _receiving_tmpdir=''
  _validate_lxc_tmpdir "${var_lxc_tmpdir:-}" || return $?
  [[ -n "${var_lxc_tmpdir:-}" ]] || return 0
  receiving_context=$(_receiving_context_contents) || return $?
  pct exec "$CTID" -- /bin/sh -c "$receiving_context"$'\n''_prepare_lxc_tmpdir "$1"' _ "$var_lxc_tmpdir" || return $?
  _receiving_tmpdir=$var_lxc_tmpdir
}

# Runs one creator-initiated package/bootstrap command in the receiver: argv,
# shell -c positionals, stdin, output and status pass through exec unchanged; only
# TMPDIR differs (the creator's value is discarded, the prepared root selected).
_receiving_exec() {
  pct exec "$CTID" -- /bin/sh -c 'r=$1; shift; unset TMPDIR; if [ -n "$r" ]; then TMPDIR=$r; export TMPDIR; fi; exec "$@"' _ "${_receiving_tmpdir:-}" "$@"
}

# One inventory owns framework membership, order and fetch sentinels for both
# delivery adapters. Capture its output before looping so invalid profiles fail.
_framework_library_inventory() {
  case "$1" in lxc | addon) ;; *) return 65 ;; esac
  printf '%s\n' \
    'core.func load_functions' \
    'error_handler.func catch_errors' \
    'install.func setup_lxc' \
    'tools.func setup_uv' \
    'github.func clone_and_deploy_gh_commit' || return $?
  if [[ "$1" == addon ]]; then
    printf '%s\n' 'addon_lxc.func addon_baseline' || return $?
  fi
}

_framework_library_fetch() {
  local profile=$1 directory=$2 inventory f sentinel size
  inventory=$(_framework_library_inventory "$profile") || return $?
  mkdir -p "$directory" || return $?
  while read -r f sentinel; do
    curl -fsSL --connect-timeout 10 "${REPO_BASE}/misc/${f}" -o "${directory}/${f}" || return $?
    size=$(stat -c%s "${directory}/${f}") || return $?
    if [[ $size -lt 100 ]]; then
      printf '%s: too small (%sb), fetch likely failed\n' "$f" "$size" >&2
      return 1
    fi
    grep -q "$sentinel" "${directory}/${f}" || {
      printf '%s missing %s\n' "$f" "$sentinel" >&2
      return 1
    }
  done <<< "$inventory"
}

_framework_library_contents() {
  local profile=$1 directory=$2 inventory f sentinel
  inventory=$(_framework_library_inventory "$profile") || return $?
  while read -r f sentinel; do
    printf '# framework: %s\n' "$f" || return $?
    cat "${directory}/${f}" || return $?
    printf '\n' || return $?
  done <<< "$inventory"
}

_framework_cache_ensure() {
  local cache_dir inventory f sentinel hit=1
  cache_dir=$(_framework_cache_dir) || return $?
  inventory=$(_framework_library_inventory lxc) || return $?
  while read -r f sentinel; do
    [[ -s "$cache_dir/$f" ]] || hit=0
  done <<< "$inventory"
  if [[ $hit == 1 ]]; then
    msg_debug "framework cache hit: ${cache_dir}"
    return 0
  fi
  msg_debug "framework cache miss: fetching from REPO_BASE=${REPO_BASE:-<unset>}"
  _framework_library_fetch lxc "$cache_dir" || return 1
}

# ------------------------------------------------------------------------------
# build_bundle()
#
# Assembles a self-contained bundle script that includes inline framework
# libraries + the extracted hook function, pushes it into the container, and
# sets its mode.
#
# Usage: build_bundle <name> <hook> <destination> <mode> [pipeline-step ...]
#
#   name        — human-readable label (install | update | uninstall)
#   hook        — function name to extract via declare -f (must exist)
#   destination — path inside the container (e.g., /tmp/install-bundle.sh)
#   mode        — chmod value (e.g., 0700, 0755)
#   pipeline    — remaining args are exact commands to emit after the hook
#
# Bundle layout inside container:
#   shebang, set -euo pipefail, minimal PATH and receiving temporary context
#   app/var_lxc_* context baked with printf %q
#   ═══ framework: core.func ═══ (inlined verbatim)
#   ═══ framework: error_handler.func ═══
#   ═══ framework: install.func ═══
#   ═══ framework: tools.func ═══
#   ═══ framework: github.func ═══
#   sanity checks (command -v load_functions, catch_errors, setup_lxc, setup_uv, clone_and_deploy_gh_commit)
#   load_functions; catch_errors; color
#   ═══ hook: <hook> ═══ (declare -f output)
#   [install] trap 'rm -f "${BASH_SOURCE[0]}"' EXIT  (self-destruct)
#   [install] <pipeline steps in order>
#   [update]  <pipeline steps in order>
#   [uninstall] <hook>; remove commands only after its normal successful return
# ------------------------------------------------------------------------------
# Source identity is producer data, never an ambient or var_lxc_* setting.
_validate_lxc_script_id() {
  local LC_ALL=C _lsi_value=${1-}
  if [[ ! "$_lsi_value" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ || "$_lsi_value" == *.sh ]]; then
    printf 'Invalid LXC source-script identity.\n' >&2
    return 65
  fi
}

# Checked prefix parser; legacy pipeline/CLI arguments remain untouched.
_lxc_script_identity_args() {
  local _lia_output=$1 _lia_count=$2 _lia_id='' _lia_used=0 _lia_arg
  shift 2
  if [[ "${1-}" == --script-id ]]; then
    [[ $# -ge 3 && "${3-}" == -- ]] || {
      printf 'Invalid source-script identity arguments.\n' >&2
      return 65
    }
    _validate_lxc_script_id "$2" || return $?
    _lia_id=$2 _lia_used=3
    for _lia_arg in "${@:4}"; do
      [[ "$_lia_arg" != --script-id ]] || {
        printf 'Duplicate source-script identity.\n' >&2
        return 65
      }
    done
  fi
  printf -v "$_lia_output" '%s' "$_lia_id" || return $?
  printf -v "$_lia_count" '%s' "$_lia_used" || return $?
}

# Internal bundle prefixes; requirement values remain literal data for core's
# numeric consent owner. An omitted pair is unknown, never inherited context.
_lxc_bundle_args() {
  local _lba_id_out=$1 _lba_cpu_out=$2 _lba_ram_out=$3 _lba_count_out=$4
  local _lba_id='' _lba_cpu='' _lba_ram='' _lba_count=0 _lba_arg
  shift 4
  if [[ "${1-}" == --script-id ]]; then
    [[ $# -ge 3 && "${3-}" == -- ]] || {
      printf 'Invalid source-script identity arguments.\n' >&2
      return 65
    }
    _validate_lxc_script_id "$2" || return $?
    _lba_id=$2 _lba_count=3
    shift 3
  fi
  if [[ "${1-}" == --requirements ]]; then
    [[ $# -ge 4 && "${4-}" == -- ]] || {
      printf 'Invalid bundle requirements arguments.\n' >&2
      return 65
    }
    _lba_cpu=$2 _lba_ram=$3
    _lba_count=$((_lba_count + 4))
    shift 4
  fi
  for _lba_arg in "$@"; do
    [[ "$_lba_arg" != --requirements && "$_lba_arg" != --script-id ]] || {
      printf 'Duplicate or misplaced bundle prefix.\n' >&2
      return 65
    }
  done
  printf -v "$_lba_id_out" '%s' "$_lba_id" || return $?
  printf -v "$_lba_cpu_out" '%s' "$_lba_cpu" || return $?
  printf -v "$_lba_ram_out" '%s' "$_lba_ram" || return $?
  printf -v "$_lba_count_out" '%s' "$_lba_count" || return $?
}

_bundle_contents() {
  local profile=$1
  shift
  case "$profile" in lxc | addon) ;; *) return 65 ;; esac
  local name="$1" hook="$2" cache_dir="$3"
  shift 3
  local _bundle_source_id='' _bundle_prefix_count=0
  local _bundle_required_cpu='' _bundle_required_ram=''
  _lxc_bundle_args _bundle_source_id _bundle_required_cpu _bundle_required_ram _bundle_prefix_count "$@" || return $?
  shift "$_bundle_prefix_count"
  local pipeline=("$@")
  local tag="${name:0:4}" _v step
  tag="${tag^^}"
  # Every producer checks its own status. The caller deliberately handles failure,
  # so neither errexit nor a checked compound block can enforce this boundary.
  _bundle_runtime_header "$profile" || return $?

  printf '%s\n' "# ═══ runtime context (baked at bundle build time) ═══" || return $?

  printf 'declare -- APP=%q\n' "$APP" || return $?
  if [[ "$profile" == addon ]]; then
    printf 'declare -- APP_SLUG=%q\n' "$APP_SLUG" || return $?
    printf 'declare -- NSAPP=%q\n' "$APP_SLUG" || return $?
    printf 'declare -- ADDON_SCRIPT_ID=%q\n' "${ADDON_SCRIPT_ID:-}" || return $?
  else
    printf 'declare -- NSAPP=%q\n' "$NSAPP" || return $?
  fi
  if [[ "$profile" == lxc && "$name" == update && -n "$_bundle_source_id" ]]; then
    printf 'declare -- LXC_SCRIPT_ID=%q\n' "$_bundle_source_id" || return $?
  fi
  if [[ "$profile" == lxc && "$name" == update ]]; then
    printf 'declare -- LXC_REQUIRED_CPU=%q\n' "$_bundle_required_cpu" || return $?
    printf 'declare -- LXC_REQUIRED_RAM=%q\n' "$_bundle_required_ram" || return $?
  fi
  printf 'declare -- REPO_BASE=%q\n' "$REPO_BASE" || return $?
  if [[ "$profile" == lxc ]]; then
    printf 'declare -- ENABLE_GPU=%q\n' "${ENABLE_GPU:-no}" || return $?
    printf 'declare -- GPU_TYPE=%q\n' "${GPU_TYPE:-}" || return $?
    printf 'declare -- INSTALL_NVIDIA_DRIVERS=%q\n' "${INSTALL_NVIDIA_DRIVERS:-}" || return $?
    printf 'declare -- CTTYPE=%q\n' "${CT_TYPE:-${CTTYPE:-1}}" || return $?
    for _v in "${!var_lxc_@}"; do
      printf 'declare -- %s=%q\n' "$_v" "${!_v}" || return $?
    done
  else
    for _v in "${!var_addon_@}"; do
      printf 'declare -- %s=%q\n' "$_v" "${!_v}" || return $?
    done
  fi

  # Run before library source-time effects as well as logs/spinners/hooks.
  _receiving_context_contents || return $?
  if [[ "$profile" == lxc ]]; then
    printf '%s\n' '_prepare_lxc_tmpdir "${var_lxc_tmpdir:-}" || exit $?' || return $?
  else
    declare -f _prepare_addon_context || return $?
    printf '%s\n' '_prepare_addon_context || exit $?' || return $?
  fi

  printf '%s\n' '_INSTALL_DEFER_BOOTSTRAP=1' || return $?
  _framework_library_contents "$profile" "$cache_dir" || return $?

  cat << BUNDLE_INIT || return $?
# ═══ runtime init ═══
command -v load_functions >/dev/null 2>&1 || { echo "FATAL: core.func not loaded" >&2; exit 111; }
command -v catch_errors >/dev/null 2>&1 || { echo "FATAL: error_handler.func not loaded" >&2; exit 111; }
command -v clone_and_deploy_gh_commit >/dev/null 2>&1 || { echo "FATAL: github.func not loaded" >&2; exit 111; }
BUNDLE_INIT

  if [[ "$profile" == lxc ]]; then
    printf '%s\n' 'declare -F setup_lxc >/dev/null || exit 111' 'declare -F setup_uv >/dev/null || exit 111' || return $?
  else
    printf '%s\n' 'declare -F pkg_install >/dev/null || exit 111' 'declare -F fetch_and_deploy_gh_release >/dev/null || exit 111' 'declare -F addon_baseline >/dev/null || exit 111' || return $?
  fi
  printf '%s\n' '_INSTALL_DEFER_BOOTSTRAP=0' \
    'if declare -F _bootstrap >/dev/null; then _bootstrap; detect_os; fi' \
    'unset _INSTALL_DEFER_BOOTSTRAP' 'load_functions' 'catch_errors' 'color' || return $?

  printf '%s\n' "# ═══ hook: ${hook} ═══" || return $?
  declare -f "$hook" || return $?

  if [[ "$profile" == addon ]]; then
    printf '%s\n' 'declare -F addon_baseline >/dev/null || exit 111' || return $?
  fi
  case "$name" in
    install)
      printf '%s\n' "# ═══ install pipeline ═══" || return $?
      printf '%s\n' "trap 'rm -f \"\${BASH_SOURCE[0]}\"' EXIT" || return $?
      for step in "${pipeline[@]}"; do
        printf '%s\n' "$step" || return $?
      done
      ;;
    update)
      printf '%s\n' "# ═══ update pipeline ═══" || return $?
      if [[ "$profile" == addon ]]; then
        printf '%s\n' '_run_update_script addon_baseline "$@"' || return $?
      else
        for step in "${pipeline[@]}"; do printf '%s\n' "$step" || return $?; done
      fi
      ;;
    uninstall)
      printf '%s\n' "# ═══ uninstall (normal hook, success-only self-destruct) ═══" || return $?
      printf '%s\n' '[[ $# == 0 ]] || { printf "Uninstall takes no options\n" >&2; exit 65; }' || return $?
      printf '%s\n' 'app_maintenance_begin "$NSAPP" || exit $?' || return $?
      printf '%s\n' "$hook" || return $?
      printf '%s\n' "  # Invoked via the /usr/bin alias, BASH_SOURCE[0] is the symlink path —" || return $?
      printf '%s\n' "  # resolve to the real bundle file so self-destruct removes both" || return $?
      printf '%s\n' "  _self=\"\$(readlink -f \"\${BASH_SOURCE[0]}\" 2>/dev/null || echo \"\${BASH_SOURCE[0]}\")\"" || return $?
      printf '%s\n' "  rm -f \"\${BASH_SOURCE[0]}\" \"\$_self\"" || return $?
      if [[ "$profile" == addon ]]; then
        printf '  rm -f %q %q %q %q\n' "$(_addon_command_path update)" "$(_addon_alias_path update)" "$(_addon_alias_path uninstall)" "${ADDON_MARKER_DIR}/${APP_SLUG}" || return $?
      else
        printf '%s\n' "  rm -f /usr/local/sbin/update /usr/bin/update /usr/bin/uninstall" || return $?
      fi
      printf '%s\n' "  echo \"[${tag}] uninstall complete, removed self\" >&2" || return $?
      ;;
  esac
}

_write_bundle() {
  _bundle_contents lxc "$@"
}

build_bundle() {
  local name="$1" hook="$2" dest="$3" mode="$4"
  shift 4
  local bundle_path cache_dir write_exit=0
  local _bundle_source_id='' _bundle_prefix_count=0
  local _bundle_required_cpu='' _bundle_required_ram=''
  local -a _bundle_identity=()
  local -a _bundle_requirements=()
  _lxc_bundle_args _bundle_source_id _bundle_required_cpu _bundle_required_ram _bundle_prefix_count "$@" || return $?
  shift "$_bundle_prefix_count"
  [[ -z "$_bundle_source_id" ]] || _bundle_identity=(--script-id "$_bundle_source_id" --)
  _bundle_requirements=(--requirements "$_bundle_required_cpu" "$_bundle_required_ram" --)

  _validate_lxc_tmpdir "${var_lxc_tmpdir:-}" || return $?
  declare -F "$hook" > /dev/null 2>&1 || {
    msg_error "hook '${hook}' not defined"
    return 1
  }
  _framework_cache_ensure || {
    msg_error "framework cache failed"
    return 1
  }
  cache_dir=$(_framework_cache_dir) || return $?
  bundle_path=$(mktemp "${TMPDIR:-/tmp}/${name}-bundle-${SESSION_ID}.XXXXXX") || return $?

  _write_bundle "$name" "$hook" "$cache_dir" "${_bundle_identity[@]}" "${_bundle_requirements[@]}" "$@" > "$bundle_path" || write_exit=$?
  if [[ $write_exit -ne 0 ]]; then
    rm -f -- "$bundle_path" || true
    msg_error "${name} bundle generation failed (exit=${write_exit})" || true
    return "$write_exit"
  fi

  # The receiver owns a same-filesystem stage too. A partial pct push or chmod
  # failure must not truncate/replace its previous valid command.
  local receiving_stage='' publication_exit=0
  pct exec "$CTID" -- mkdir -p -- "${dest%/*}" || publication_exit=$?
  if [[ $publication_exit -eq 0 ]]; then receiving_stage=$(pct exec "$CTID" -- mktemp "${dest}.XXXXXX") || publication_exit=$?; fi
  if [[ $publication_exit -eq 0 && ("$receiving_stage" != "$dest".* || "$receiving_stage" == *$'\n'*) ]]; then
    receiving_stage=''
    publication_exit=111
  fi
  if [[ $publication_exit -eq 0 ]]; then pct push "$CTID" "$bundle_path" "$receiving_stage" >&2 || publication_exit=$?; fi
  if [[ $publication_exit -eq 0 ]]; then pct exec "$CTID" -- chmod "$mode" "$receiving_stage" > /dev/null 2>&1 || publication_exit=$?; fi
  if [[ $publication_exit -eq 0 ]]; then pct exec "$CTID" -- mv -f -- "$receiving_stage" "$dest" || publication_exit=$?; fi
  if [[ $publication_exit -ne 0 && -n "$receiving_stage" ]]; then
    pct exec "$CTID" -- rm -f -- "$receiving_stage" > /dev/null 2>&1 || true
  fi
  rm -f -- "$bundle_path" || true
  if [[ $publication_exit -ne 0 ]]; then
    msg_error "${name} bundle publication failed (exit=${publication_exit})" || true
    return "$publication_exit"
  fi
  msg_debug "${name} bundle pushed → ${dest} (mode ${mode})"
}
