# Definition-only SSH access owner. Callers provide the account and transport.

# ------------------------------------------------------------------------------
# ssh_extract_keys_from_file()
#
# - Emits provenance|key records, retaining the legacy stripped key for root.
# - Only an original bare line is eligible for application-account selection.
# ------------------------------------------------------------------------------
ssh_extract_keys_from_file() {
  local f="$1"
  [[ -r "$f" ]] || return 0
  tr -d '\r' < "$f" | awk '
    BEGIN { type = "(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256))" }
    /^[[:space:]]*#/ {next}
    /^[[:space:]]*$/ {next}
    $0 ~ ("^[[:space:]]*" type "[[:space:]]+") {
      sub(/^[[:space:]]*/, "")
      print "bare|" $0
      next
    }
    # Unparsed prefix: keep the historical root-picker output, never reuse it.
    {
      if (match($0, type "[[:space:]]+")) print "prefixed|" substr($0, RSTART)
    }
  '
}

# ------------------------------------------------------------------------------
# ssh_build_choices_from_files()
#
# - Builds interactive whiptail checklist of available SSH keys
# - Generates fingerprint, type and comment for each key
# ------------------------------------------------------------------------------
ssh_build_choices_from_files() {
  local _account=$1
  shift
  local -a files=("$@")
  CHOICES=()
  COUNT=0
  # global: configure_ssh_settings reads the id|key map written here
  SSH_MAP_FILE="$(mktemp)" || return $?
  local f id key provenance typ fp cmt base _typ _b64 _cmt

  for f in "${files[@]}"; do
    [[ -f "$f" && -r "$f" ]] || continue
    base="$(basename -- "$f")" || return $?
    case "$base" in
      known_hosts | known_hosts.* | config) continue ;;
      id_*) [[ "$f" != *.pub ]] && continue ;;
    esac

    # map every key in file
    while IFS='|' read -r provenance key; do
      [[ -n "$key" ]] || continue

      typ=""
      fp=""
      cmt=""
      read -r _typ _b64 _cmt <<< "$key"
      typ="${_typ:-key}"
      cmt="${_cmt:-}"
      # Fingerprint via ssh-keygen (if available)
      if [[ $_account != root ]]; then
        [[ $provenance == bare ]] || continue
        fp=$(_ssh_access_public_key "$key") || continue
        read -r _ fp _ <<< "$fp"
      elif command -v ssh-keygen > /dev/null 2>&1; then
        fp="$(printf '%s\n' "$key" | ssh-keygen -lf - 2> /dev/null | awk '{print $2}')" || fp=''
      fi
      # Label shorten
      [[ ${#cmt} -gt 40 ]] && cmt="${cmt:0:37}..."

      COUNT=$((COUNT + 1))
      id="K${COUNT}"
      printf '%s\n' "${id}|${provenance}|${key}" >> "$SSH_MAP_FILE" || return $?
      CHOICES+=("$id" "[$typ] ${fp:+$fp }${cmt:+$cmt }— ${base}" "OFF")
    done < <(ssh_extract_keys_from_file "$f")
  done
}

# ------------------------------------------------------------------------------
# ssh_discover_default_files()
#
# - Scans standard paths for SSH keys
# - Includes ~/.ssh/*.pub, /etc/ssh/authorized_keys, etc.
# ------------------------------------------------------------------------------
ssh_discover_default_files() {
  local -a cand=()
  shopt -s nullglob
  cand+=(/root/.ssh/authorized_keys /root/.ssh/authorized_keys2)
  cand+=(/root/.ssh/*.pub)
  cand+=(/etc/ssh/authorized_keys /etc/ssh/authorized_keys.d/*)
  shopt -u nullglob
  printf '%s\0' "${cand[@]}"
}

_ssh_access_dialog() {
  local _dialog_status
  if whiptail "$@"; then return 0; else _dialog_status=$?; fi
  case $_dialog_status in
    1 | 255) return 130 ;;
    *) return "$_dialog_status" ;;
  esac
}

# Expand one literal folder/path or one shell glob, without evaluating shell
# syntax or splitting spaces in the input or in filenames. Keep dotfiles out
# of ordinary folder selection, just as in the standard .pub discovery.
_ssh_access_scan_files() (
  local _scan=$1 _file
  [[ -n "$_scan" ]] || return 0
  set +f
  case $_scan in
    \~) _scan=${HOME:-/root} ;;
    \~/*) _scan=${HOME:-/root}/${_scan:2} ;;
  esac
  [[ $_scan == /* ]] || _scan=./$_scan
  if [[ -d "$_scan" ]]; then
    shopt -s nullglob
    for _file in "${_scan%/}"/*; do printf '%s\0' "$_file" || return $?; done
  elif [[ -f "$_scan" ]]; then
    printf '%s\0' "$_scan"
  else
    # Bash expansion, in a child with splitting disabled, preserves spaces and
    # even newline-bearing filenames, unlike compgen's line-delimited output.
    local IFS=''
    shopt -s nullglob
    # shellcheck disable=SC2086 # Intentional pathname expansion, without splitting.
    for _file in $_scan; do printf '%s\0' "$_file" || return $?; done
  fi
)

# The legacy root installation consumes SSH_KEYS_FILE, but the app collector
# can only reuse root selections whose original line was already bare.
_ssh_access_record_key_selection() {
  local _account=$1 _provenance=$2 _key=$3
  [[ -n $_key ]] || return 0
  printf '%s\n' "$_key" >> "$SSH_KEYS_FILE" || return $?
  if [[ $_account == root && $_provenance == bare ]] && _ssh_access_public_key "$_key" > /dev/null; then
    SSH_REUSABLE_KEYS+="$_key"$'\n'
  fi
}

_ssh_access_record_key_tags() {
  local _account=$1 _selection=$2 _tag _record _provenance _key
  for _tag in $_selection; do
    _tag=${_tag%\"}
    _tag=${_tag#\"}
    [[ $_tag =~ ^K[0-9]+$ ]] || continue
    _record=$(grep -m1 "^${_tag}|" "$SSH_MAP_FILE") || return $?
    IFS='|' read -r _ _provenance _key <<< "$_record"
    _ssh_access_record_key_selection "$_account" "$_provenance" "$_key" || return $?
  done
}

ssh_access_pick_keys() {
  local backtitle=$1 _picker_account=$2
  local -a _def_files _scan_files

  SSH_KEYS_FILE="$(mktemp)" || return $?
  SSH_REUSABLE_KEYS=''

  mapfile -d '' -t _def_files < <(ssh_discover_default_files)
  ssh_build_choices_from_files "$_picker_account" "${_def_files[@]}" || return $?
  local default_key_count="$COUNT"

  local ssh_key_mode
  if [[ "$default_key_count" -gt 0 ]]; then
    ssh_key_mode=$(_ssh_access_dialog --backtitle "$backtitle" --title "SSH KEY SOURCE" --menu \
      "Provision SSH keys for $_picker_account:" 14 72 4 \
      "found" "Select from detected keys (${default_key_count})" \
      "manual" "Paste a single public key" \
      "folder" "Scan another folder (path or glob)" \
      "none" "No keys" 3>&1 1>&2 2>&3) || return $?
  elif [[ $_picker_account == root ]]; then
    ssh_key_mode=$(_ssh_access_dialog --backtitle "$backtitle" --title "SSH KEY SOURCE" --menu \
      "No host keys detected; choose manual/none:" 12 72 2 \
      "manual" "Paste a single public key" \
      "none" "No keys" 3>&1 1>&2 2>&3) || return $?
  else
    ssh_key_mode=$(_ssh_access_dialog --backtitle "$backtitle" --title "SSH KEY SOURCE" --menu \
      "No host keys detected; choose another source:" 13 72 3 \
      "manual" "Paste a single public key" \
      "folder" "Scan another folder (path or glob)" \
      "none" "No keys" 3>&1 1>&2 2>&3) || return $?
  fi

  case "$ssh_key_mode" in
    found)
      local selection
      selection=$(_ssh_access_dialog --backtitle "$backtitle" --title "SELECT HOST KEYS" \
        --checklist "Select one or more keys to import:" 20 140 10 "${CHOICES[@]}" 3>&1 1>&2 2>&3) || return $?
      _ssh_access_record_key_tags "$_picker_account" "$selection" || return $?
      ;;
    manual)
      SSH_AUTHORIZED_KEY="$(_ssh_access_dialog --backtitle "$backtitle" \
        --inputbox "Paste one SSH public key line (ssh-ed25519/ssh-rsa/...)" 10 72 --title "SSH Public Key" 3>&1 1>&2 2>&3)" || return $?
      # A pasted root line has no transformation; validate it before reuse.
      _ssh_access_record_key_selection "$_picker_account" bare "$SSH_AUTHORIZED_KEY" || return $?
      ;;
    folder)
      local glob_path
      glob_path=$(_ssh_access_dialog --backtitle "$backtitle" \
        --inputbox "Enter a folder or glob to scan (e.g. /root/.ssh/*.pub)" 10 72 --title "Scan Folder/Glob" 3>&1 1>&2 2>&3) || return $?
      if [[ -n "$glob_path" ]]; then
        mapfile -d '' -t _scan_files < <(_ssh_access_scan_files "$glob_path")
        if [[ "${#_scan_files[@]}" -gt 0 ]]; then
          rm -f -- "$SSH_MAP_FILE" || return $?
          ssh_build_choices_from_files "$_picker_account" "${_scan_files[@]}" || return $?
          if [[ "$COUNT" -gt 0 ]]; then
            local folder_selection
            folder_selection=$(_ssh_access_dialog --backtitle "$backtitle" --title "SELECT FOLDER KEYS" \
              --checklist "Select key(s) to import:" 20 78 10 "${CHOICES[@]}" 3>&1 1>&2 2>&3) || return $?
            _ssh_access_record_key_tags "$_picker_account" "$folder_selection" || return $?
          else
            whiptail --backtitle "$backtitle" --msgbox "No keys found in: $glob_path" 8 60
          fi
        else
          whiptail --backtitle "$backtitle" --msgbox "Path/glob returned no files." 8 60
        fi
      fi
      ;;
    none)
      :
      ;;
  esac

  if [[ -s "$SSH_KEYS_FILE" ]]; then
    sort -u -o "$SSH_KEYS_FILE" "$SSH_KEYS_FILE" || return $?
    printf '\n' >> "$SSH_KEYS_FILE" || return $?
  fi

  return 0
}

ssh_access_validate_account() {
  [[ $# == 1 && "$1" != root && "$1" =~ ^[a-z_][a-z0-9_-]*$ ]]
}

_ssh_access_pick_app_keys() (
  local _target=$1 _reuse=$2 _selection _scratch _rc=0
  local SSH_KEYS_FILE='' SSH_AUTHORIZED_KEY='' SSH_MAP_FILE='' SSH_REUSABLE_KEYS='' COUNT=0
  local -a CHOICES=()
  if [[ -n "$_reuse" ]]; then
    _selection=$(_ssh_access_dialog --title 'SSH PUBLIC KEY' --menu \
      "Stage 2 of 2: Choose public keys for $_target. Private keys stay on your client." 13 76 2 \
      reuse 'Reuse the public keys already selected for root' select 'Select separate public keys' 3>&1 1>&2 2>&3) || return $?
    case "$_selection" in
      reuse)
        printf '%s\n' "$_reuse"
        return $?
        ;;
      select) ;;
      *) return 65 ;;
    esac
  fi
  _scratch=$(mktemp -d) || return $?
  export TMPDIR="$_scratch"
  if ssh_access_pick_keys 'SSH access [Stage 2 of 2]' "$_target"; then
    cat "$SSH_KEYS_FILE" || _rc=$?
  else
    _rc=$?
  fi
  local _cleanup=0
  rm -rf -- "$_scratch" || _cleanup=$?
  [[ $_rc != 0 ]] || _rc=$_cleanup
  return "$_rc"
)

_ssh_access_error() {
  printf 'SSH access: %s\n' "$*" >&2
}

_ssh_access_public_key() {
  local _type _blob _comment
  [[ "$1" != *[$'\r\n']* ]] || return 65
  read -r _type _blob _comment <<< "$1"
  [[ "$_type" =~ ^(ssh-|ecdsa-|sk-)[a-zA-Z0-9@._+-]+$ && "$_blob" =~ ^[a-zA-Z0-9+/]+={0,2}$ ]] || return 65
  # Require a bare public key, not an options line, private key or certificate.
  [[ "$_type" != *-cert-v01@openssh.com ]] || return 65
  printf '%s %s\n' "$_type" "$_blob" | ssh-keygen -lf - 2> /dev/null
}

# An explicit root picker outcome (even No keys) supersedes saved defaults.
# Never reconstruct provenance from the already normalized installation file.
ssh_access_root_reuse() {
  local _selection_file=$1 _proven=$2 _default=$3
  if [[ -n $_selection_file ]]; then
    if [[ -s $_selection_file && -n $_proven ]]; then printf '%s' "$_proven"; fi
  elif [[ -n $_default ]] && _ssh_access_public_key "$_default" > /dev/null; then
    printf '%s\n' "$_default"
  fi
}

_ssh_access_key_lines() {
  local _line
  while IFS= read -r _line; do
    [[ -n "$_line" ]] || continue
    _ssh_access_public_key "$_line" > /dev/null || {
      _ssh_access_error 'Invalid public key'
      return 65
    }
    printf '%s\n' "$_line" || return $?
  done <<< "$1"
}

# Explicit unattended inputs select the mode by their presence. Read the FD to
# EOF, allowing one terminal LF (for a newline-terminated secret store record).
# A NUL, embedded newline, empty input or invalid FD is a checked error.
ssh_access_collect_inputs() {
  local -
  set +x +a
  local _file=$1 _fd=$2 _mode_out=$3 _keys_out=$4 _password_out=$5
  local _input='' _key_data='' _password_data='' _mode=pending
  export -n _input _key_data _password_data "${_keys_out?}" "${_password_out?}" || return $?
  if [[ -n "$_file" ]]; then
    if [[ ! -f "$_file" || ! -r "$_file" ]] || IFS= read -r -d '' _input < "$_file"; then
      _ssh_access_error 'Key file must be a readable public-key text file without NUL bytes'
      return 65
    fi
    _key_data=$(_ssh_access_key_lines "$_input") || return $?
    [[ -n "$_key_data" ]] || {
      _ssh_access_error 'Key file contains no public keys'
      return 65
    }
    _mode=key
  fi
  if [[ -n "$_fd" ]]; then
    if [[ ! $_fd =~ ^([3-9]|[1-9][0-9]+)$ ]] || ! { : <&"$_fd"; } 2> /dev/null ||
      IFS= read -r -d '' -u "$_fd" _password_data; then
      _ssh_access_error 'Supply a readable password FD above 2, without NUL bytes'
      return 65
    fi
    _password_data=${_password_data%$'\n'}
    if [[ -z "$_password_data" || "$_password_data" == *[$'\r\n']* ]]; then
      _ssh_access_error 'Password must be nonempty and cannot contain line breaks'
      return 65
    fi
    if [[ $_mode == key ]]; then _mode=both; else _mode=password; fi
  fi
  printf -v "$_mode_out" '%s' "$_mode" || return $?
  printf -v "$_keys_out" '%s' "$_key_data" || return $?
  printf -v "$_password_out" '%s' "$_password_data"
}

# Option and variable scoping must precede any expansion of a password. The
# output-variable names are supplied by the framework, never by the operator.
ssh_access_collect() {
  local -
  set +x +a
  local _account=$1 _reuse=$2 _mode_out=$3 _keys_out=$4 _password_out=$5
  local _chosen _chosen_keys='' _pw='' _confirmation='' _st _capture
  export -n _pw _confirmation _capture "${_keys_out?}" "${_password_out?}" || return $?
  ssh_access_validate_account "$_account" || return 65
  command -v whiptail > /dev/null || {
    _ssh_access_error 'whiptail is required for guided setup'
    return 69
  }
  _chosen=$(_ssh_access_dialog --title 'SSH ACCESS METHOD' --menu \
    "Stage 1 of 2: Choose SSH access for $_account. Password is for manual login; use a key for unattended MCP. Both allows either method." \
    15 76 3 key 'SSH public key' password 'Separate account password' both 'Key or password' 3>&1 1>&2 2>&3) || return $?
  case "$_chosen" in
    key | both)
      _chosen_keys=$(_ssh_access_pick_app_keys "$_account" "$_reuse") || return $?
      _chosen_keys=$(_ssh_access_key_lines "$_chosen_keys") || return $?
      [[ -n "$_chosen_keys" ]] || {
        _ssh_access_error 'No public key selected'
        return 65
      }
      ;;
    password) ;;
    *) return 65 ;;
  esac
  if [[ "$_chosen" != key ]]; then
    while :; do
      # A suffix prevents command substitution from stripping any trailing LF.
      _capture=$(
        _ssh_access_dialog --title 'SSH ACCOUNT PASSWORD' --passwordbox \
          "Stage 2 of 2: Enter a separate SSH password for $_account." 10 76 3>&1 1>&2 2>&3
        _st=$?
        printf '.'
        exit "$_st"
      ) || return $?
      _pw=${_capture%.}
      _capture=$(
        _ssh_access_dialog --title 'CONFIRM SSH ACCOUNT PASSWORD' --passwordbox \
          "Confirm the SSH password for $_account." 10 76 3>&1 1>&2 2>&3
        _st=$?
        printf '.'
        exit "$_st"
      ) || return $?
      _confirmation=${_capture%.}
      if [[ -n "$_pw" && "$_pw" != *[$'\r\n']* && "$_pw" == "$_confirmation" ]]; then break; fi
      _ssh_access_dialog --title 'SSH ACCOUNT PASSWORD' --msgbox 'Passwords must match and cannot be empty or contain line breaks.' 9 76 || return $?
    done
  fi
  printf -v "$_mode_out" '%s' "$_chosen" || return $?
  printf -v "$_keys_out" '%s' "$_chosen_keys" || return $?
  printf -v "$_password_out" '%s' "$_pw"
}

_ssh_access_policy_block() {
  local _target=$1 _key=$2 _pass=$3 _methods=$4
  printf '# scripts-underground ssh-access begin %s\nMatch User %s\n    PubkeyAuthentication %s\n    PasswordAuthentication %s\n    KbdInteractiveAuthentication no\n    AuthenticationMethods %s\n# scripts-underground ssh-access end %s\n' \
    "$_target" "$_target" "$_key" "$_pass" "$_methods" "$_target"
}

# Append a new exact-user Match at EOF, or replace a previously emitted block
# in place. The end comment does not end Match scope: refuse foreign directives
# in that scope instead of guessing who owns them. Preserve other line bytes.
_ssh_access_candidate() {
  local _conf=$1 _target=$2 _key=$3 _pass=$4 _methods=$5
  local _line _eol=$'\n' _data='' _block='' _inside=0 _seen=0 _suffix=0
  local _begin="# scripts-underground ssh-access begin $_target"
  local _end="# scripts-underground ssh-access end $_target"
  local _replacement _key_only _password_only _both
  [[ -r "$_conf" ]] || return 66
  if IFS= read -r -d '' _data < "$_conf"; then return 65; fi # Refuse NUL bytes.
  _replacement=$(_ssh_access_policy_block "$_target" "$_key" "$_pass" "$_methods") || return $?
  _key_only=$(_ssh_access_policy_block "$_target" yes no publickey) || return $?
  _password_only=$(_ssh_access_policy_block "$_target" no yes password) || return $?
  _both=$(_ssh_access_policy_block "$_target" yes yes 'publickey password') || return $?
  while [[ -n "$_data" ]]; do
    _line=${_data%%$'\n'*}
    if [[ "$_data" == *$'\n'* ]]; then
      _eol=$'\n' _data=${_data#*$'\n'}
    else
      _eol='' _data=''
    fi
    case "$_line" in
      "$_begin")
        [[ $_inside == 0 && $_seen == 0 ]] || return 65
        _inside=1 _seen=1 _block="$_line$_eol"
        ;;
      "$_end")
        [[ $_inside == 1 ]] || return 65
        _block+="$_line"
        [[ "$_block" == "$_key_only" || "$_block" == "$_password_only" || "$_block" == "$_both" ]] || return 65
        printf '%s%s' "$_replacement" "$_eol" || return $?
        _inside=0 _suffix=1
        ;;
      *)
        if [[ $_inside == 1 ]]; then
          _block+="$_line$_eol"
        else
          # Catch malformed markers for this account, not markers for other
          # accounts or operator comments unrelated to this component.
          if [[ $_line =~ ^[[:blank:]]*#[[:blank:]]*scripts-underground[[:blank:]]+ssh-access[[:blank:]]+(begin|end)[[:blank:]]+${_target}([[:space:]]|$) ]]; then return 65; fi
          if [[ $_suffix == 1 && ! $_line =~ ^[[:space:]]*(#.*)?$ ]]; then
            [[ $_line =~ ^[[:blank:]]*[Mm][Aa][Tt][Cc][Hh]([[:blank:]]|=) ]] || return 65
            _suffix=0
          fi
          printf '%s%s' "$_line" "$_eol" || return $?
        fi
        ;;
    esac
  done
  [[ $_inside == 0 ]] || return 65
  if [[ $_seen == 0 ]]; then
    [[ -n "$_eol" ]] || printf '\n' || return $?
    printf '%s\n' "$_replacement" || return $?
  fi
  return 0
}

_ssh_access_effective() {
  local _file=$1 _account=$2 _peer=$3
  sshd -T -f "$_file" -C "user=$_account,host=localhost,addr=$_peer"
}

# Recognize complete words only. Escaped/concatenated forms are not interpreted
# here: for Match they remain potentially applicable; for an Include we cannot
# establish which files are in scope and refuse. sshd validates the real config.
_ssh_access_words() {
  local _rest=$1 _word_re=$'^("[^"\\\\]*"|\'[^\'\\\\]*\'|[^[:blank:]"\'\\\\]+)([[:blank:]]+|$)'
  while :; do
    _rest=${_rest#"${_rest%%[![:blank:]]*}"}
    [[ -n $_rest && $_rest != \#* ]] || return 0
    [[ $_rest =~ $_word_re ]] || return 65
    printf '%s\n' "${BASH_REMATCH[1]}" || return $?
    _rest=${_rest#"${BASH_REMATCH[0]}"}
  done
}

# A rejected account predicate rules out the entire conjunctive Match. Leave
# peer-dependent and unrecognized selectors possible, not false. Delegate
# User/Group pattern lists, including negation, to the native engine.
_ssh_access_match_excludes() {
  local _account=$1 _raw=$2 _words _term _value _probe _out
  local -a _terms
  _words=$(_ssh_access_words "$_raw") && [[ -n $_words ]] || return 1
  mapfile -t _terms <<< "$_words"
  while ((${#_terms[@]})); do
    _term=${_terms[0]}
    _terms=("${_terms[@]:1}")
    if [[ $_term == \"*\" || $_term == \'*\' ]]; then _term=${_term:1:-1}; fi
    case "${_term,,}" in
      invalid-user) return 0 ;;
      user=* | group=* | host=* | address=* | localaddress=* | localport=* | rdomain=* | version=*)
        _value=${_term#*=}
        _term=${_term%%=*}
        ;;
      user | group | host | address | localaddress | localport | rdomain | version)
        ((${#_terms[@]})) || return 1
        _value=${_terms[0]}
        _terms=("${_terms[@]:1}")
        if [[ $_value == \"*\" || $_value == \'*\' ]]; then _value=${_value:1:-1}; fi
        ;;
      *) return 1 ;;
    esac
    if [[ ${_term,,} == user || ${_term,,} == group ]]; then
      # Replay only one simple operand, never re-tokenize a quoted compound
      # value as a different account pattern.
      [[ $_value =~ ^[a-zA-Z0-9_.,!?*@+-]+$ ]] || continue
      printf -v _probe 'Match %s %s\n PermitTTY no' "$_term" "$_value"
      _out=$(sshd -T -f /dev/stdin -C "user=$_account" <<< "$_probe" 2> /dev/null) || return 1
      if grep -Fxq 'permittty yes' <<< "$_out"; then return 0; fi
    fi
  done
  return 1
}

# Resolve one Include selector at a time with sshd, not shell globs. This
# preserves sshd's expansion rules, including its relative config directory.
# Only direct diagnostic entries belong to this Include; the recursive scan
# handles descendants under their own scope. Require a recognized trace even
# for an empty glob, otherwise the expansion is not established.
_ssh_access_include_files() {
  local _selector=$1 _trace _line _seen=no _file
  _trace=$(LC_ALL=C sshd -ddd -t -f /dev/stdin <<< "Include $_selector" 2>&1) || return 65
  while IFS= read -r _line; do
    case "${_line%$'\r'}" in
      'debug2: /dev/stdin line 1: new include '*) _seen=yes ;;
      'debug2: /dev/stdin line 1: including '*)
        _file=${_line#'debug2: /dev/stdin line 1: including '}
        _file=${_file%$'\r'}
        [[ $_file == /* && -f $_file ]] || return 65
        printf '%s\n' "$_file" || return $?
        ;;
    esac
  done <<< "$_trace"
  [[ $_seen == yes ]]
}

# OpenSSH takes the first value from a satisfied Match, ahead of globals.
# Inspect the prefix preceding our block. An included file inherits the
# caller's scope but its own Match directives do not change the caller's.
# Conservatively refuse earlier differing values in any possible app scope,
# even if determining the exact intersection of network predicates is hard.
_ssh_access_check_prefix() {
  local _file=$1 _account=$2 _pub=$3 _pass=$4 _methods=$5 _scope=${6:-global}
  local _top=${7:-yes} _line _keyword _args _expected _words _selector _files _child
  local _directive=$'^[ \t\r]*("([a-zA-Z][a-zA-Z0-9]*)"|([a-zA-Z][a-zA-Z0-9]*))[ \t\r]*(=[ \t\r]*)?(.*)$'
  [[ -r $_file && -f $_file ]] || return 65
  if IFS= read -r -d '' _ < "$_file"; then return 65; fi
  while IFS= read -r _line || [[ -n $_line ]]; do
    if [[ $_top == yes && $_line == "# scripts-underground ssh-access begin $_account" ]]; then return 0; fi
    _line=${_line%$'\r'}
    [[ $_line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    [[ $_line =~ $_directive ]] || return 65
    _keyword=${BASH_REMATCH[2]:-${BASH_REMATCH[3]}}
    _args=${BASH_REMATCH[5]}
    case "${_keyword,,}" in
      match)
        _scope=possible
        if _ssh_access_match_excludes "$_account" "$_args"; then _scope=excluded; fi
        continue
        ;;
      include)
        [[ $_scope != excluded ]] || continue
        _words=$(_ssh_access_words "$_args") && [[ -n $_words ]] || return 65
        while IFS= read -r _selector; do
          _files=$(_ssh_access_include_files "$_selector") || return 65
          [[ -n $_files ]] || continue
          while IFS= read -r _child; do
            _ssh_access_check_prefix "$_child" "$_account" "$_pub" "$_pass" "$_methods" "$_scope" no || return $?
          done <<< "$_files"
        done <<< "$_words"
        continue
        ;;
      pubkeyauthentication) _expected=$_pub ;;
      passwordauthentication) _expected=$_pass ;;
      kbdinteractiveauthentication | challengeresponseauthentication) _expected=no ;;
      authenticationmethods) _expected=$_methods ;;
      *) continue ;;
    esac
    [[ $_scope == possible ]] || continue
    _words=$(_ssh_access_words "$_args") || return 65
    _words=${_words//$'\n'/ }
    if [[ $_words != "$_expected" ]]; then
      _ssh_access_error "Earlier SSH Match may override $_keyword for $_account in $_file"
      return 65
    fi
  done < "$_file"
}

# Debian's OpenSSH permits group-write only when the group is private. Check
# primary as well as explicit group membership, like its secure_permissions.
_ssh_access_private_key_group() {
  local _owner=$1 _group=$2 _uid=$3 _version _record _members _name _primary
  _version=$(sshd -V 2>&1) && [[ $_version == OpenSSH_*' Debian-'* ]] || return 1
  _record=$(getent group "$_group") && [[ $_record != *$'\n'* ]] || return 1
  _members=${_record##*:}
  _record=$(getent passwd "$_owner") && [[ $_record != *$'\n'* ]] || return 1
  _name=${_record%%:*}
  [[ -n $_name && (-z $_members || $_members == "$_name") ]] || return 1
  _primary=$(getent passwd | awk -F: -v g="$_group" -v u="$_uid" '
    $4 == g { if ($3 != u) bad = 1; found = 1 }
    END { if (bad) exit 1; print found + 0 }') || return 1
  [[ $_primary == 1 || -n $_members ]]
}

# OpenSSH safe_path checks the regular key file, directory and canonical home
# (then stops at the home). Existing path ownership and modes are not repaired
# here. New files below a safe home are created privately by the account.
_ssh_access_strict_key_path() {
  local _home=$1 _uid=$2 _path _metadata _owner _group _mode
  for _path in "$_home" "$_home/.ssh" "$_home/.ssh/authorized_keys"; do
    [[ ! -L $_path || $_path == "$_home" ]] || break
    [[ -e $_path ]] || return 0
    _metadata=$(stat -Lc '%u %g %a' -- "$_path") || break
    read -r _owner _group _mode <<< "$_metadata"
    if [[ $_path == */authorized_keys ]]; then [[ -f $_path ]] || break; else [[ -d $_path ]] || break; fi
    if [[ $_owner != 0 && $_owner != "$_uid" ]] || ((8#$_mode & 002)); then break; fi
    if ((8#$_mode & 020)) && ! _ssh_access_private_key_group "$_owner" "$_group" "$_uid"; then break; fi
    if [[ $_path == "$_home/.ssh/authorized_keys" ]]; then return 0; fi
  done
  _ssh_access_error "StrictModes would reject $_path; check its owner (root or the application account) and remove group/other write access; nothing applied"
  return 65
}

# Run this writer AS the application user, never as root through paths the
# account can replace. Keep existing file bytes/options; do not append a bare
# copy of an already present restricted key. No recursive chmod/chown.
_ssh_access_append_keys() (
  umask 077
  local _home=$1 _ssh_dir=$1/.ssh _auth=$1/.ssh/authorized_keys
  local _line _fp _present _add=''
  [[ -d "$_home" && ! -L "$_ssh_dir" && ! -L "$_auth" ]] || return 65
  if [[ -e "$_auth" ]]; then
    [[ -f "$_auth" && -r "$_auth" && -w "$_auth" ]] || return 65
    # ssh-keygen includes option-prefixed keys; status 255 also means a file
    # has only comments/blank lines, which are preserved.
    _present=$(ssh-keygen -lf "$_auth" 2> /dev/null) || _present=''
    _present=$(awk '{print $2}' <<< "$_present") || return $?
  fi
  while IFS= read -r _line; do
    _fp=$(_ssh_access_public_key "$_line") || return $?
    read -r _ _fp _ <<< "$_fp"
    if ! grep -Fxq -- "$_fp" <<< "${_present-}"; then
      _add+="$_line"$'\n'
      _present+=$'\n'"$_fp"
    fi
  done
  [[ -n "$_add" ]] || return 0
  [[ -d "$_ssh_dir" ]] || mkdir -m 0700 -- "$_ssh_dir" || return $?
  if [[ -s "$_auth" ]]; then
    printf '\n%s' "$_add" >> "$_auth" || return $?
  else
    printf '%s' "$_add" >> "$_auth" || return $?
  fi
)

# This is an optimistic recheck, not a lock against an unrelated root editor.
# ctime observes metadata edits (including ACL/xattr); daemon reads can change
# atime, so it is preserved separately rather than included in this comparison.
_ssh_access_policy_identity() {
  local _path=$1 _links
  [[ -f "$_path" && ! -L "$_path" ]] || return 65
  _links=$(stat -c '%h' -- "$_path") || return $?
  [[ $_links == 1 ]] || return 65
  stat -c '%d:%i:%f:%u:%g:%h:%s:%y:%z' -- "$_path"
}

_ssh_access_policy_unchanged() {
  local _live=$1 _snapshot=$2 _identity=$3 _now
  _now=$(_ssh_access_policy_identity "$_live") && [[ "$_now" == "$_identity" ]] &&
    cmp -s -- "$_live" "$_snapshot" &&
    _now=$(_ssh_access_policy_identity "$_live") && [[ "$_now" == "$_identity" ]]
}

# Only listeners owned by the actual sshd main PID count. A listener also
# held by systemd is inherited, not a successful standalone rebind.
_ssh_access_listener_state() (
  local -
  set -o pipefail
  local _family _records _endpoints
  # Query by address family: ss can print a dual-stack IPv6 wildcard as *:PORT.
  _endpoints=$(
    for _family in 4 6; do
      _records=$(LC_ALL=C ss -H -ltnpe "-$_family") || exit $?
      LC_ALL=C awk -v pid="$1" -v family="$_family" '
        index($0, "(\"sshd\",pid=" pid ",fd=") {
          owner = index($0, "(\"systemd\",pid=1,fd=") ? "socket" : "service"
          inode = ""; v6 = ""
          for (i = 6; i <= NF; i++) {
            if ($i ~ /^ino:[1-9][0-9]*$/) inode = $i
            if ($i ~ /^v6only:[01]$/) v6 = "/" $i
          }
          if (inode == "" || $4 !~ /:[0-9]+$/) exit 69
          print owner, inode, family "/" $4 v6
        }
      ' <<< "$_records" || exit $?
    done | LC_ALL=C sort -u
  ) || return $?
  [[ -n $_endpoints ]] || return 69
  printf '%s\n' "$_endpoints"
)

_ssh_access_rebound_listeners() {
  LC_ALL=C awk '
    FNR == NR { previous_inode[$2] = 1; required_endpoint[$3] = 1; next }
    $2 in previous_inode { exit 69 }
    { delete required_endpoint[$3] }
    END { for (endpoint in required_endpoint) exit 69 }
  ' <(printf '%s\n' "$1") <(printf '%s\n' "$2")
}

# sshd.c: prepare_proctitle and server_accept_loop render the saved startup
# arguments in the listener title; sighup_restart reuses those arguments.
# Check the complete known invocation, not a prefix or a search for -f/-o.
_ssh_access_daemon_uses_policy() {
  local _pid=$1 _live=$2 _title _binary
  local _stock='^sshd: /usr/sbin/sshd -D \[listener\] [0-9]+ of [0-9]+-[0-9]+ startups$'
  _binary=$(type -P sshd) || return 69
  [[ $_binary -ef /proc/$_pid/exe && $_live -ef /proc/$_pid/root/etc/ssh/sshd_config ]] || return 69
  IFS= read -r -d '' _title < "/proc/$_pid/cmdline" || return 69
  [[ $_title =~ $_stock ]] || return 69
}

# A restart takes new arguments from systemd, unlike OpenSSH's SIGHUP. Check
# the loaded recipe as well as the live daemon; never source the environment
# file. For variable expansion only admit the known empty Debian input shape.
_ssh_access_restart_uses_policy() {
  local _unit=$1 _defaults=/etc/default/ssh
  local _direct='ExecStart={ path=/usr/sbin/sshd ; argv[]=/usr/sbin/sshd -D ; ignore_errors=no ; '
  local _expanded='ExecStart={ path=/usr/sbin/sshd ; argv[]=/usr/sbin/sshd -D $SSHD_OPTS ; ignore_errors=no ; '
  grep -Fxq 'RootDirectory=' <<< "$_unit" && grep -Fxq 'RootImage=' <<< "$_unit" || return 69
  if [[ $'\n'$_unit == *$'\n'"$_direct"* ]]; then return 0; fi
  [[ $'\n'$_unit == *$'\n'"$_expanded"* ]] && grep -Fxq 'Environment=' <<< "$_unit" &&
    grep -Fxq 'PassEnvironment=' <<< "$_unit" &&
    grep -Fxq 'EnvironmentFiles=/etc/default/ssh (ignore_errors=yes)' <<< "$_unit" || return 69
  if [[ ! -e $_defaults && ! -L $_defaults ]]; then return 0; fi
  [[ -f $_defaults && -r $_defaults ]] || return 69
  LC_ALL=C awk '/^[[:blank:]]*([#;].*)?$/ {next} /^[[:blank:]]*SSHD_OPTS=(""|\047\047)?[[:blank:]]*$/ {next} {exit 69}' "$_defaults"
}

_ssh_access_activation_state() {
  local _live=$1
  local _unit _socket _trigger _pid _invocation _listeners _operation=reload
  _unit=$(systemctl show --all ssh.service -p Id,LoadState,ActiveState,SubState,Result,MainPID,InvocationID,TriggeredBy,KillMode,Type,CanReload,ExecStart,ExecStop,ExecStopPost,ConsistsOf,PropagatesStopTo,RootDirectory,RootImage,Environment,PassEnvironment,EnvironmentFiles) || return $?
  grep -Fxq 'Id=ssh.service' <<< "$_unit" && grep -Fxq 'LoadState=loaded' <<< "$_unit" &&
    grep -Fxq 'ActiveState=active' <<< "$_unit" && grep -Fxq 'SubState=running' <<< "$_unit" &&
    grep -Fxq 'Result=success' <<< "$_unit" || return 69
  _pid=$(sed -n 's/^MainPID=//p' <<< "$_unit") || return $?
  _invocation=$(sed -n 's/^InvocationID=//p' <<< "$_unit") || return $?
  [[ $_pid =~ ^[1-9][0-9]*$ && $_invocation =~ ^[[:xdigit:]]{32}$ ]] || return 69
  _ssh_access_daemon_uses_policy "$_pid" "$_live" || return $?
  _listeners=$(_ssh_access_listener_state "$_pid") || return $?
  _trigger=$(grep '^TriggeredBy=' <<< "$_unit") || return $?
  case "$_trigger" in
    TriggeredBy=ssh.socket)
      _socket=$(systemctl show --all ssh.socket -p Id,LoadState,ActiveState,SubState,Result,Accept,Triggers) || return $?
      grep -Fxq 'Id=ssh.socket' <<< "$_socket" && grep -Fxq 'LoadState=loaded' <<< "$_socket" &&
        grep -Fxq 'Triggers=ssh.service' <<< "$_socket" || return 69
      if grep -Fxq 'ActiveState=active' <<< "$_socket"; then
        # Never restart a customized stop lifecycle that could kill sessions,
        # or a service that would propagate the stop to another unit.
        grep -Fxq 'SubState=running' <<< "$_socket" && grep -Fxq 'Result=success' <<< "$_socket" &&
          grep -Fxq 'Accept=no' <<< "$_socket" && grep -Fxq 'Type=notify' <<< "$_unit" &&
          grep -Fxq 'KillMode=process' <<< "$_unit" && grep -Fxq 'ConsistsOf=' <<< "$_unit" &&
          grep -Fxq 'PropagatesStopTo=' <<< "$_unit" &&
          ! grep -Eq '^ExecStop(Post)?=.' <<< "$_unit" && ! grep -q '^service ' <<< "$_listeners" || return 69
        _operation=restart
        _ssh_access_restart_uses_policy "$_unit" || return $?
      else
        grep -Fxq 'ActiveState=inactive' <<< "$_socket" || return 69
      fi
      ;;
    TriggeredBy=) ;;
    *) return 69 ;;
  esac
  if [[ $_operation == reload ]]; then
    grep -Fxq 'CanReload=yes' <<< "$_unit" && ! grep -q '^socket ' <<< "$_listeners" || return 69
  fi
  printf '%s %s %s\n%s\n' "$_operation" "$_pid" "$_invocation" "$_listeners"
}

_ssh_access_activate() {
  local _before=$1 _effects=$2 _live=$3 _operation _pid _invocation _listeners
  local _after _new_operation _new_pid _new_invocation _new_listeners _status _attempt
  if _after=$(_ssh_access_activation_state "$_live") && [[ $_after == "$_before" ]]; then
    read -r _operation _pid _invocation <<< "$_before"
    _listeners=${_before#*$'\n'}
  else
    _ssh_access_error "SSH policy was written ($_effects), but listener topology changed or could not be rechecked; no activation attempted"
    return 69
  fi
  if systemctl "$_operation" ssh.service; then :; else
    _status=$?
    _ssh_access_error "SSH policy was written ($_effects), but ssh.service $_operation failed; effective access is unconfirmed"
    return "$_status"
  fi

  # A signal-based reload can acknowledge before sshd has replaced its
  # listeners. Do not probe via a new connection: it could start ssh.service
  # via the socket and hide a failed activation. Observe only native state.
  for ((_attempt = 0; _attempt < 20; _attempt++)); do
    if _after=$(_ssh_access_activation_state "$_live"); then
      read -r _new_operation _new_pid _new_invocation <<< "$_after"
      _new_listeners=${_after#*$'\n'}
      if [[ $_operation == restart && $_new_operation == restart && $_new_pid != "$_pid" &&
        $_new_invocation != "$_invocation" && $_new_listeners == "$_listeners" ]]; then return 0; fi
      if [[ $_operation == reload && $_new_operation == reload && $_new_pid == "$_pid" &&
        $_new_invocation == "$_invocation" ]] && _ssh_access_rebound_listeners "$_listeners" "$_new_listeners"; then return 0; fi
    fi
    sleep 0.1 || break
  done
  _ssh_access_error "SSH policy was written ($_effects), but ssh.service $_operation could not be confirmed; effective access is unconfirmed"
  return 69
}

_ssh_access_apply_candidate() {
  local _account=$1 _mode=$2 _live=$3 _candidate=$4 _home=$5 _keys_var=$6 _pw_var=$7
  local _pub=no _pass=no _methods _snapshot=${4}.original _identity _atime _effective _before _peer _key_writer
  local _status _effects='no credential operation completed' _key _activation _uid _strict=no
  local _attributes=mode,ownership,xattr
  case "$_mode" in
    key) _pub=yes _methods=publickey ;;
    password) _pass=yes _methods=password ;;
    both) _pub=yes _pass=yes _methods='publickey password' ;;
    *) return 65 ;;
  esac

  _identity=$(_ssh_access_policy_identity "$_live") || {
    _status=$?
    _ssh_access_error 'sshd_config must be a regular, non-symlinked, single-link file; nothing applied'
    return "$_status"
  }
  _atime=$(stat -c '%x' -- "$_live") || return $?
  # Explicit preserve list: unlike --preserve=all, xattr copy failures are errors.
  if [[ -e /sys/fs/selinux/enforce ]]; then _attributes+=,context; fi
  cp --preserve="$_attributes,timestamps" -- "$_live" "$_snapshot" || return $?
  _ssh_access_candidate "$_snapshot" "$_account" "$_pub" "$_pass" "$_methods" > "$_candidate" || {
    _status=$?
    _ssh_access_error 'Cannot prepare SSH policy; check for edits to the managed block or its Match scope; nothing applied'
    return "$_status"
  }
  sshd -t -f "$_candidate" || {
    _status=$?
    _ssh_access_error 'SSH policy syntax validation failed; nothing applied'
    return "$_status"
  }
  if ! _ssh_access_check_prefix "$_candidate" "$_account" "$_pub" "$_pass" "$_methods"; then
    _ssh_access_error 'Cannot establish the requested mode for all peers; check earlier SSH Match and Include policy; nothing applied'
    return 65
  fi
  # Retain native sanity checks of the selected mode, key path and root policy.
  for _peer in 127.0.0.1 ::1; do
    _effective=$(_ssh_access_effective "$_candidate" "$_account" "$_peer") || return $?
    if ! grep -Fxq "pubkeyauthentication $_pub" <<< "$_effective" ||
      ! grep -Fxq "passwordauthentication $_pass" <<< "$_effective" ||
      ! grep -Fxq 'kbdinteractiveauthentication no' <<< "$_effective" ||
      ! grep -Fxq "authenticationmethods $_methods" <<< "$_effective"; then
      _ssh_access_error 'Existing SSH policy overrides the requested authentication mode; nothing applied'
      return 65
    fi
    if [[ $_pub == yes ]] && ! grep -Eq '^authorizedkeysfile( [^ ]+)* (\.ssh/authorized_keys|%h/\.ssh/authorized_keys)( |$)' <<< "$_effective"; then
      _ssh_access_error 'Existing SSH policy does not read the standard authorized_keys file; nothing applied'
      return 65
    fi
    if grep -Fxq 'strictmodes yes' <<< "$_effective"; then _strict=yes; fi
    _before=$(_ssh_access_effective "$_snapshot" root "$_peer") || return $?
    _effective=$(_ssh_access_effective "$_candidate" root "$_peer") || return $?
    if [[ "$_before" != "$_effective" ]]; then
      _ssh_access_error 'Candidate changes root SSH settings; nothing applied'
      return 65
    fi
  done

  if [[ $_pub == yes && $_strict == yes ]]; then
    _uid=$(id -u -- "$_account") || return $?
    _ssh_access_strict_key_path "$_home" "$_uid" || return $?
  fi
  if cp --attributes-only --preserve="$_attributes" -- "$_snapshot" "$_candidate" &&
    touch -m -r "$_snapshot" -- "$_candidate" && touch -a -d "$_atime" -- "$_candidate"; then :; else
    _status=$?
    _ssh_access_error 'Cannot preserve sshd_config metadata; nothing applied'
    return "$_status"
  fi
  _activation=$(_ssh_access_activation_state "$_live") || {
    _status=$?
    _ssh_access_error 'Cannot establish an active ssh.service listener using the validated sshd_config without overrides; nothing applied'
    return "$_status"
  }
  if [[ $_pub == yes ]]; then
    while IFS= read -r _key; do _ssh_access_public_key "$_key" > /dev/null || return 65; done <<< "${!_keys_var}"
    _key_writer=$(declare -f _ssh_access_public_key _ssh_access_append_keys) || return $?
  fi
  if ! _ssh_access_policy_unchanged "$_live" "$_snapshot" "$_identity"; then
    _ssh_access_error 'sshd_config changed or could not be rechecked during validation; nothing applied'
    return 75
  fi
  if [[ $_pub == yes ]]; then
    if runuser -u "$_account" -- /bin/bash -c "$_key_writer"$'\n''_ssh_access_append_keys "$1"' _ "$_home" <<< "${!_keys_var}"; then
      _effects='authorized_keys applied'
    else
      _status=$?
      _ssh_access_error 'Key installation failed; authorized_keys may be partially changed; password and SSH policy were not applied'
      return "$_status"
    fi
  fi
  if [[ $_pass == yes ]]; then
    if printf '%s:%s\n' "$_account" "${!_pw_var}" | chpasswd > /dev/null 2>&1; then
      if [[ $_pub == yes ]]; then _effects+='; password changed'; else _effects='password changed'; fi
    else
      _status=$?
      _ssh_access_error "Password operation failed ($_effects); password outcome is unconfirmed and SSH policy was not applied"
      return "$_status"
    fi
  fi
  if ! _ssh_access_policy_unchanged "$_live" "$_snapshot" "$_identity"; then
    _ssh_access_error "sshd_config changed or could not be rechecked ($_effects); SSH policy was not published"
    return 75
  fi
  if mv -fT -- "$_candidate" "$_live"; then
    :
  else
    _status=$?
    _ssh_access_error "Cannot publish SSH policy ($_effects); access configuration incomplete"
    return "$_status"
  fi
  _ssh_access_activate "$_activation" "$_effects" "$_live"
}

# NUL-framed public-key lines, then a password, then EOF. Neither frame is argv.
ssh_access_apply() (
  set +x +a
  set -o pipefail
  local _sa_account=${1-} _sa_mode=${2-} _sa_keys='' _sa_password='' _extra=''
  local _entry _name _uid _home _shell _stage _status=0 _lock_fd _lock_dir _lock_owner _lock_mode
  local _config=/etc/ssh/sshd_config
  [[ $# == 2 && $EUID == 0 ]] && ssh_access_validate_account "$_sa_account" || return 65
  # Lock the root-owned directory, not sshd_config (which we atomically replace)
  # or an app-specific lock. The transaction subshell owns the FD until exit.
  _lock_dir=${_config%/*}
  if [[ ! -d $_lock_dir || -L $_lock_dir ]] || ! exec {_lock_fd}< "$_lock_dir" ||
    [[ ! $_lock_dir -ef /proc/self/fd/$_lock_fd ]] ||
    ! read -r _lock_owner _lock_mode < <(stat -Lc '%u %a' -- "/proc/self/fd/$_lock_fd") ||
    [[ $_lock_owner != 0 || ! $_lock_mode =~ ^[0-7]{3,4}$ ]] || ((8#$_lock_mode & 0022)); then
    _ssh_access_error 'Cannot lock a non-private SSH configuration directory; nothing applied'
    return 69
  fi
  if flock -n -E 75 "$_lock_fd"; then :; else
    _status=$?
    if [[ $_status == 75 ]]; then
      _ssh_access_error 'Another SSH access setup is active; nothing applied, retry after it finishes'
    else
      _ssh_access_error 'Cannot lock the SSH configuration directory; nothing applied'
    fi
    return "$_status"
  fi
  export -n _sa_keys _sa_password _extra || return $?
  if ! IFS= read -r -d '' _sa_keys || ! IFS= read -r -d '' _sa_password || IFS= read -r -d '' _extra || [[ -n "$_extra" ]]; then
    _ssh_access_error 'Invalid credential stream; nothing applied'
    return 65
  fi
  case "$_sa_mode" in
    key) [[ -n "$_sa_keys" && -z "$_sa_password" ]] || return 65 ;;
    password) [[ -z "$_sa_keys" && -n "$_sa_password" ]] || return 65 ;;
    both) [[ -n "$_sa_keys" && -n "$_sa_password" ]] || return 65 ;;
    *) return 65 ;;
  esac
  [[ "$_sa_password" != *[$'\r\n']* ]] || return 65
  _entry=$(getent passwd "$_sa_account") || return $?
  [[ "$_entry" != *$'\n'* ]] || return 65
  IFS=: read -r _name _ _uid _ _ _home _shell <<< "$_entry"
  if [[ "$_name" != "$_sa_account" || ! "$_uid" =~ ^[1-9][0-9]*$ ||
    "$_home" != /* || "$_home" == / || "$_home" == /root || ! -d "$_home" ||
    ! -x "$_shell" || "${_shell##*/}" == nologin || "${_shell##*/}" == false ]]; then
    _ssh_access_error 'No suitable non-root application account; nothing applied'
    return 65
  fi
  _stage=$(mktemp -d -- "${_config%/*}/.ssh-access.XXXXXXXX") || return $?
  _ssh_access_apply_candidate "$_sa_account" "$_sa_mode" "$_config" "$_stage/candidate" "$_home" _sa_keys _sa_password || _status=$?
  if rm -f -- "$_stage/candidate" "$_stage/candidate.original" && rmdir -- "$_stage"; then :; else
    local _cleanup=$?
    _ssh_access_error 'Cannot remove private SSH policy stage'
    [[ $_status != 0 ]] || _status=$_cleanup
  fi
  return "$_status"
)

# Password input remains in the collecting shell up to this pipe. Arguments to
# the transport command are all public; do not run this through a logger.
ssh_access_send() (
  set +x +a
  set -o pipefail
  local _keys_ref=$1 _password_ref=$2
  shift 2
  printf '%s\0%s\0' "${!_keys_ref}" "${!_password_ref}" | "$@"
)

_ssh_access_command() (
  set +x +a
  local _target=$1
  shift
  [[ $EUID == 0 && ${2-} == "$_target" ]] || {
    _ssh_access_error "Run as root: configure-ssh-access $_target"
    return 65
  }
  if [[ $# == 3 && $1 == --apply ]]; then
    ssh_access_apply "$_target" "$3"
    return $?
  fi
  [[ $# == 2 && $1 == --interactive && -t 0 && -t 1 ]] || {
    _ssh_access_error 'A terminal is required for guided setup'
    return 65
  }
  command -v whiptail > /dev/null || {
    _ssh_access_error 'whiptail is required for guided setup'
    return 69
  }
  local _cli_mode='' _cli_keys='' _cli_password='' _rc
  export -n _cli_keys _cli_password || return $?
  if ssh_access_collect "$_target" '' _cli_mode _cli_keys _cli_password; then
    ssh_access_send _cli_keys _cli_password ssh_access_apply "$_target" "$_cli_mode" || return $?
    printf 'SSH authentication configured for %s (%s). Verify the host key before connecting.\n' "$_target" "$_cli_mode"
  else
    _rc=$?
    if [[ $_rc == 130 ]]; then
      _ssh_access_error 'Setup cancelled; existing access was not changed'
      return 0
    fi
    return "$_rc"
  fi
)

_ssh_access_command_functions() {
  declare -f ssh_access_validate_account _ssh_access_error _ssh_access_public_key \
    ssh_extract_keys_from_file ssh_build_choices_from_files ssh_discover_default_files \
    _ssh_access_dialog _ssh_access_scan_files _ssh_access_record_key_selection _ssh_access_record_key_tags ssh_access_pick_keys _ssh_access_pick_app_keys \
    _ssh_access_key_lines ssh_access_collect _ssh_access_policy_block _ssh_access_candidate \
    _ssh_access_effective _ssh_access_words _ssh_access_match_excludes _ssh_access_include_files _ssh_access_check_prefix \
    _ssh_access_private_key_group _ssh_access_strict_key_path _ssh_access_append_keys _ssh_access_policy_identity _ssh_access_policy_unchanged \
    _ssh_access_listener_state _ssh_access_rebound_listeners _ssh_access_daemon_uses_policy _ssh_access_restart_uses_policy \
    _ssh_access_activation_state _ssh_access_activate _ssh_access_apply_candidate ssh_access_apply \
    ssh_access_send _ssh_access_command
}

ssh_access_host_api() {
  declare -F ssh_access_collect_inputs ssh_access_root_reuse ssh_access_command_contents ssh_access_install_command _ssh_access_install_alias > /dev/null || return $?
  _ssh_access_command_functions > /dev/null
}

ssh_access_command_contents() {
  ssh_access_validate_account "$@" || return 65
  printf '%s\n' '#!/bin/bash' 'set -euo pipefail' 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin' || return $?
  _ssh_access_command_functions || return $?
  printf 'if [[ ${1-} == --apply ]]; then\n  _ssh_access_command %q "$@"\nelse\n  _ssh_access_command %q --interactive "$@"\nfi\n' "$1" "$1"
}

ssh_access_install_command() {
  local _target=$1 _dest=/usr/local/sbin/configure-ssh-access _stage _rc
  ssh_access_validate_account "$_target" || return 65
  mkdir -p -- "${_dest%/*}" || return $?
  _stage=$(mktemp -- "${_dest}.XXXXXXXX") || return $?
  if ssh_access_command_contents "$_target" > "$_stage" && bash -n "$_stage" && chmod 0755 "$_stage" &&
    _ssh_access_install_alias "$_dest" && mv -fT -- "$_stage" "$_dest"; then
    return 0
  else
    _rc=$?
    rm -f -- "$_stage" || :
    return "$_rc"
  fi
}

_ssh_access_install_alias() {
  local _alias=/usr/bin/configure-ssh-access _previous
  if [[ -L "$_alias" ]]; then
    _previous=$(readlink -- "$_alias") || return $?
    [[ $_previous == "$1" ]] && return 0
  elif [[ ! -e "$_alias" ]]; then
    ln -s -- "$1" "$_alias"
    return $?
  fi
  _ssh_access_error 'Existing configure-ssh-access alias is not framework-owned'
  return 65
}
