#!/usr/bin/env bash
# ==============================================================================
# ADDON BOOTSTRAP — entry-point shim for addon scripts (scripts/addon/*.sh)
#
# Addons run INSIDE an existing LXC container. install.func's source-time
# _bootstrap provides: curl-ensure, core.func + error_handler.func,
# load_functions, catch_errors, get_lxc_ip, detect_os.
#
# Every line below is a source, a guard, or a framework function call.
# User hooks are invoked only by framework functions — never by the shim.
# ==============================================================================

# shellcheck disable=SC1090  # Dynamic URLs resolved at runtime via REPO_BASE

# pct exec / cron / non-login shells provide a minimal PATH (no /usr/local/bin).
# Normalize so freshly installed binaries are callable by bare name.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

source <(curl -fsSL "${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}/misc/install.func")
source <(curl -fsSL "${REPO_BASE}/misc/tools.func")
source <(curl -fsSL "${REPO_BASE}/misc/github.func")
source <(curl -fsSL "${REPO_BASE}/misc/addon.func")

command -v addon_guard > /dev/null 2>&1 || {
  echo "FATAL: addon framework failed to load (check network / REPO_BASE)" >&2
  exit 1
}

addon_guard
addon_init
addon_dispatch
