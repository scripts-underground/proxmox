source <(curl -fsSL "${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}/misc/build.func") 2>/dev/null || true

if ! grep -q container=lxc /proc/1/environ 2>/dev/null; then
  echo "Error: must run inside LXC container"
  exit 1
fi

source <(curl -fsSL "$SCRIPTS_URL/misc/core.func") 2>/dev/null || true
source <(curl -fsSL "$SCRIPTS_URL/misc/tools.func") 2>/dev/null || true

APP_SLUG="$(echo "${APP:-}" | tr '[:upper:] ' '[:lower:]-' | sed 's/--*/-/g; s/-$//')"

if [[ "${MODE:-}" == "update" ]]; then
  declare -F update_script >/dev/null 2>&1 && update_script
  exit 0
elif [[ "${MODE:-}" == "uninstall" ]]; then
  declare -F uninstall_script >/dev/null 2>&1 && uninstall_script
  exit 0
fi

if declare -F install_script >/dev/null 2>&1; then
  install_script
fi

declare -F post_install_script >/dev/null 2>&1 && post_install_script

if [[ -n "${APP_SLUG:-}" ]]; then
  cat <<CLIEOF > "/usr/bin/update-${APP_SLUG}"
#!/usr/bin/env bash
MODE=update bash -c "\$(curl -fsSL ${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}/scripts/addon/${APP_SLUG}.sh)"
CLIEOF
  chmod +x "/usr/bin/update-${APP_SLUG}"

  cat <<CLIEOF > "/usr/bin/uninstall-${APP_SLUG}"
#!/usr/bin/env bash
MODE=uninstall bash -c "\$(curl -fsSL ${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}/scripts/addon/${APP_SLUG}.sh)"
CLIEOF
  chmod +x "/usr/bin/uninstall-${APP_SLUG}"
fi
