#!/usr/bin/env bash
# Addon entry: only definition loading precedes root/CT and context admission.
# shellcheck source=/dev/null
source <(curl -fsSL "${REPO_BASE:-https://raw.githubusercontent.com/scripts-underground/proxmox/main}/misc/addon_lxc.func")
declare -F _addon_bootstrap > /dev/null || {
  printf 'FATAL: addon entry not loaded\n' >&2
  exit 111
}
_addon_bootstrap "$@"
