#!/usr/bin/env bash

# AMD GPU Helper Functions for Proxmox LXC / ROCm passthrough
# Author: CanbiZ
# License: MIT

set -euo pipefail

function exit_script() {
  printf "⚠️  User exited script\n"
  exit 0
}

function msg() {
  local type="$1"
  shift
  case "$type" in
    info) printf " \033[36m➤\033[0m %s\n" "$@" ;;
    ok) printf " \033[32m✔\033[0m %s\n" "$@" ;;
    warn) printf " \033[33m⚠\033[0m %s\n" "$@" >&2 ;;
    err) printf " \033[31m✘\033[0m %s\n" "$@" >&2 ;;
  esac
}

function amd_gpu_available() {
  lspci | grep -qi 'VGA.*AMD' && [[ -e /dev/kfd ]]
}

function passthrough_amd_to_lxc() {
  local ctid="$1"
  local dev numbers major minor
  local required=() entries=()
  [[ "$ctid" =~ ^[1-9][0-9]{2,8}$ ]] || return 65
  if ! declare -F gpu_config_node > /dev/null || ! declare -F gpu_write_lxc_config > /dev/null; then
    msg err "Shared GPU configuration support unavailable"
    return 127
  fi

  if ! amd_gpu_available; then
    msg warn "No AMD GPU with ROCm support detected"
    return 1
  fi

  for dev in /dev/kfd /dev/dri/card* /dev/dri/renderD*; do
    if [[ "$dev" != /dev/kfd && ! -e "$dev" && ! -L "$dev" ]]; then continue; fi
    if numbers=$(gpu_config_node "$dev"); then :; else return $?; fi
    major=${numbers%%:*} minor=${numbers#*:}
    required+=("$dev:$major:$minor")
    entries+=("lxc.cgroup2.devices.allow" "c $major:* rwm")
  done
  entries+=("lxc.mount.entry" "/dev/kfd dev/kfd none bind,optional,create=file"
    "lxc.mount.entry" "/dev/dri dev/dri none bind,optional,create=dir")
  if gpu_write_lxc_config "$ctid" "${#required[@]}" "${required[@]}" "${entries[@]}"; then :; else return $?; fi

  msg ok "AMD ROCm passthrough applied to CT $ctid"
  return 0
}

function _amd_ct_os() {
  local kind
  if kind=$(pct exec "$1" -- sh -c '
    if grep -qi alpine /etc/os-release; then printf alpine; else
      rc=$?; [ "$rc" -eq 1 ] || exit "$rc"; printf other
    fi
  '); then :; else return $?; fi
  case "$kind" in alpine | other) printf '%s' "$kind" ;; *)
    msg err "Invalid container OS probe output"
    return 65
    ;;
  esac
}

function install_amd_tools_in_ct() {
  local ctid="$1" kind
  [[ "$ctid" =~ ^[1-9][0-9]{2,8}$ ]] || return 65
  if kind=$(_amd_ct_os "$ctid"); then :; else return $?; fi
  if [[ "$kind" == alpine ]]; then
    msg warn "Skipping tool installation: Alpine container detected"
    return 0
  fi

  msg info "Installing AMD GPU tools in CT $ctid..."
  if pct exec "$ctid" -- bash -c '
         apt-get update || exit $?
         DEBIAN_FRONTEND=noninteractive apt-get install -y rocm-smi rocm-utils || exit $?
         user=$(id -un 0) || exit $?
         adduser "$user" video || exit $?
         adduser "$user" render || exit $?
       ' > /dev/null 2>&1; then :; else return $?; fi

  msg ok "Installed ROCm tools inside CT $ctid"
}
