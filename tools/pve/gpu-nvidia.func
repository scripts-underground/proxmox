#!/usr/bin/env bash

# NVIDIA GPU Integration for Proxmox LXC
# Author: CanbiZ
# License: MIT

set -euo pipefail

function nvidia_helper_contents() {
  # Definitions only: this component owns its runtime closure, including msg.
  # No source-time state, descriptors, initialization or traps are exported.
  declare -f msg nvidia_exit nvidia_check_driver_installed nvidia_get_driver_version \
    nvidia_get_cuda_version nvidia_validate_driver_version nvidia_validate_cuda_version \
    nvidia_setup_kernel_modules nvidia_valid_minor nvidia_gpu_available nvidia_select_gpu_minor \
    nvidia_lxc_passthrough nvidia_write_lxc_config || return $?
}

function nvidia_exit() {
  printf "⚠️  User exited script\n"
  exit 0
}

function msg() {
  local type="$1"
  shift
  case "$type" in
    info) printf " \033[36m➤\033[0m %s\n" "$@" ;;
    ok) printf " \033[32m✔\033[0m %s\n" "$@" ;;
    warn) printf " \033[33m⚠\033[0m %s\n" "$@" >&2 ;;
    err) printf " \033[31m✘\033[0m %s\n" "$@" >&2 ;;
  esac
}

function nvidia_check_driver_installed() {
  command -v nvidia-smi &> /dev/null
}

function nvidia_get_driver_version() {
  local output line version=''
  if output=$(LC_ALL=C nvidia-smi --query-gpu=driver_version --format=csv,noheader,nounits); then :; else return $?; fi
  while IFS= read -r line; do
    if [[ ! "$line" =~ ^[[:space:]]*([0-9]{1,4}\.[0-9]{1,4}(\.[0-9]{1,4})?)[[:space:]]*$ ]]; then
      msg err "Invalid NVIDIA driver version output"
      return 65
    fi
    line=${BASH_REMATCH[1]}
    if [[ -n "$version" && "$version" != "$line" ]]; then
      msg err "Ambiguous NVIDIA driver versions"
      return 65
    fi
    version=$line
  done <<< "$output"
  printf '%s' "$version"
}

function nvidia_get_cuda_version() {
  local output line version='' count=0
  if output=$(LC_ALL=C nvidia-smi -q); then :; else return $?; fi
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*CUDA[[:space:]]+(UMD[[:space:]]+)?Version[[:space:]]*:[[:space:]]*(.*)$ ]] || continue
    line=${BASH_REMATCH[2]}
    if [[ ! "$line" =~ ^([0-9]{1,4}\.[0-9]{1,4}(\.[0-9]{1,4})?)[[:space:]]*$ ]]; then
      msg err "Invalid NVIDIA CUDA driver capability"
      return 65
    fi
    version=${BASH_REMATCH[1]}
    count=$((count + 1))
  done <<< "$output"
  if [[ "$count" != 1 ]]; then
    msg err "Missing or ambiguous NVIDIA CUDA driver capability"
    return 65
  fi
  printf '%s' "$version"
}

function nvidia_validate_driver_version() {
  if ! nvidia_check_driver_installed; then
    msg err "nvidia-smi not found; install host drivers separately"
    return 127
  fi
  local ver major confirm=''
  if ver=$(nvidia_get_driver_version); then :; else return $?; fi
  major=${ver%%.*}
  if ((10#$major < 500)); then
    msg warn "Detected old NVIDIA driver version: $ver"
    read -rp "Continue anyway? [y/N]: " confirm || confirm=''
    [[ "${confirm,,}" =~ ^(y|yes)$ ]] || return 1
  fi
  return 0
}

function nvidia_validate_cuda_version() {
  if ! nvidia_check_driver_installed; then
    msg err "nvidia-smi not found; install host drivers separately"
    return 127
  fi
  local ver major confirm=''
  if ver=$(nvidia_get_cuda_version); then :; else return $?; fi
  major=${ver%%.*}
  if ((10#$major < 11)); then
    msg warn "Detected old CUDA driver capability: $ver (not an installed toolkit)"
    read -rp "Continue anyway? [y/N]: " confirm || confirm=''
    [[ "${confirm,,}" =~ ^(y|yes)$ ]] || return 1
  fi
  return 0
}

function nvidia_setup_kernel_modules() {
  local modfile="/etc/modules-load.d/nvidia.conf"
  local udevfile="/etc/udev/rules.d/70-nvidia.rules"

  printf "nvidia\nnvidia_uvm\nnvidia_drm\n" > "$modfile"

  cat << EOF > "$udevfile"
KERNEL=="nvidia", RUN+="/bin/bash -c '/usr/bin/nvidia-smi -L && chmod 666 /dev/nvidia*'"
KERNEL=="nvidia_uvm", RUN+="/bin/bash -c '/usr/bin/nvidia-modprobe -c0 -u && chmod 0666 /dev/nvidia-uvm*'"
EOF

  msg ok "NVIDIA modules configured"
  msg warn "Reboot the host to apply kernel changes"
}

function nvidia_valid_minor() {
  [[ "$1" =~ ^(0|[1-9][0-9]{0,6})$ ]] && ((10#$1 <= 1048575))
}

function nvidia_gpu_available() {
  local device
  for device in /dev/nvidia[0-9]*; do
    [[ "$device" =~ ^/dev/nvidia[0-9]+$ && -c "$device" ]] && return 0
  done
  return 1
}

function nvidia_select_gpu_minor() {
  local menu=() max=0 info record line model minor selected rc models minors
  local -A seen=()
  if [[ ! -d /proc/driver/nvidia/gpus || ! -r /proc/driver/nvidia/gpus || ! -x /proc/driver/nvidia/gpus ]]; then
    msg err "NVIDIA GPU inventory is unavailable"
    return 1
  fi
  # Directory/record enumeration is shell-owned: no unchecked process substitution.
  for info in /proc/driver/nvidia/gpus/*; do
    [[ -e "$info" || -L "$info" ]] || continue
    [[ -d "$info" ]] || continue
    if record=$(cat "$info/information"); then :; else return $?; fi
    model='' minor='' models=0 minors=0
    while IFS= read -r line; do
      if [[ "$line" =~ ^Model:[[:space:]]*(.+)$ ]]; then
        model=${BASH_REMATCH[1]} models=$((models + 1))
      elif [[ "$line" =~ ^Device[[:space:]]Minor:[[:space:]]*(.*)$ ]]; then
        minor=${BASH_REMATCH[1]} minors=$((minors + 1))
      fi
    done <<< "$record"
    if [[ "$models" != 1 || "$minors" != 1 ]] || ! nvidia_valid_minor "$minor" || [[ -n "${seen[$minor]:-}" ]]; then
      msg err "Invalid or duplicate NVIDIA GPU record: $info/information"
      return 65
    fi
    seen[$minor]=1
    menu+=("$minor" "$model" "OFF")
    ((${#model} <= max)) || max=${#model}
  done
  if [[ ${#menu[@]} == 0 ]]; then
    msg err "No NVIDIA GPU found"
    return 1
  elif [[ ${#menu[@]} == 3 ]]; then
    selected=${menu[0]}
  elif selected=$(whiptail --title "NVIDIA GPU Selection" --radiolist \
    "Select GPU for passthrough:" 15 $((max + 40)) 6 "${menu[@]}" 3>&1 1>&2 2>&3); then
    :
  else
    rc=$?
    if [[ "$rc" == 1 || "$rc" == 255 ]]; then
      msg warn "NVIDIA GPU selection cancelled"
      return 1
    fi
    return "$rc"
  fi
  if ! nvidia_valid_minor "$selected" || [[ -z "${seen[$selected]:-}" ]]; then
    msg err "Invalid NVIDIA GPU selection"
    return 65
  fi
  printf '%s' "$selected"
}

function nvidia_lxc_passthrough() {
  if [[ $# != 2 || ! "$1" =~ ^[1-9][0-9]{2,8}$ ]] || ! nvidia_valid_minor "${2:-}"; then
    msg err "Invalid NVIDIA container ID or device minor"
    return 65
  fi
  local ctid="$1" minor="$2" dev numbers major_hex minor_hex major rc n
  local devices=(
    "/dev/nvidia${minor}"
    "/dev/nvidiactl"
    "/dev/nvidia-uvm"
    "/dev/nvidia-uvm-tools"
  )

  local entries=() devnums=() required=()
  for dev in "${devices[@]}"; do
    if [[ ! -e "$dev" && ! -L "$dev" && "$dev" == /dev/nvidia-uvm* ]]; then continue; fi
    if [[ ! -c "$dev" ]]; then
      msg err "NVIDIA character device unavailable: $dev"
      return 69
    fi
    if numbers=$(stat -Lc '%t:%T' "$dev"); then :; else return $?; fi
    if [[ ! "$numbers" =~ ^([[:xdigit:]]{1,8}):([[:xdigit:]]{1,8})$ ]]; then
      msg err "Invalid NVIDIA device numbers: $dev"
      return 65
    fi
    major_hex=${BASH_REMATCH[1]} minor_hex=${BASH_REMATCH[2]}
    major=$((16#$major_hex))
    if ((major == 0 || major > 4095 || 16#$minor_hex > 1048575)); then
      msg err "Out-of-range NVIDIA device numbers: $dev"
      return 65
    fi
    if [[ "$dev" == "/dev/nvidia${minor}" ]] && ((16#$minor_hex != 10#$minor)); then
      msg err "NVIDIA device minor changed: $dev"
      return 65
    fi
    devnums+=("$major")
    required+=("$dev:$major:$((16#$minor_hex))")
    entries+=("lxc.mount.entry" "$dev dev/${dev##*/} none bind,optional,create=file")
  done
  entries+=("lxc.mount.entry" "/dev/dri dev/dri none bind,optional,create=dir")
  for n in "${devnums[@]}"; do
    entries+=("lxc.cgroup2.devices.allow" "c ${n}:* rwm")
  done

  # Native PVE owns locking, parsing and publication. Never append after snapshots.
  if nvidia_write_lxc_config "$ctid" "${#required[@]}" "${required[@]}" "${entries[@]}"; then
    :
  else
    rc=$?
    msg err "NVIDIA passthrough configuration failed for CT $ctid"
    return "$rc"
  fi
  msg ok "NVIDIA passthrough configured for CT $ctid"
  return 0
}

# A terminal command keeps Bash declaration export reparsable even with a heredoc.
function nvidia_write_lxc_config() {
  perl -MPVE::LXC::Config -MPVE::Cluster -MPVE::Tools -MStorable=dclone - "$@" << 'PERL'
use strict;
use warnings;
use Fcntl qw(:mode O_RDONLY O_NONBLOCK);
use Errno qw(ENOENT);
use JSON::PP;
my $ctid = shift @ARGV;
my $required_count = shift @ARGV;
my %required_nodes = map { my ($path, $major, $minor) = split /:/; $path => [$major, $minor] }
    splice(@ARGV, 0, $required_count);
my @required = values %required_nodes;
my @wanted;
while (@ARGV) { push @wanted, [shift @ARGV, shift @ARGV]; }
my $attempted = 0;
sub difference {
    my ($a, $b, $path) = @_;
    return $path if ref($a) ne ref($b);
    if (ref($a) eq 'HASH') {
        my %keys = map { $_ => 1 } (keys %$a, keys %$b);
        for my $key (sort keys %keys) {
            return "$path/$key" if !exists($a->{$key}) || !exists($b->{$key});
            my $bad = difference($a->{$key}, $b->{$key}, "$path/$key");
            return $bad if defined($bad);
        }
    } elsif (ref($a) eq 'ARRAY') {
        return $path if @$a != @$b;
        for my $i (0 .. $#$a) {
            my $bad = difference($a->[$i], $b->[$i], "$path/$i");
            return $bad if defined($bad);
        }
    } else {
        return $path if defined($a) != defined($b) || (defined($a) && "$a" ne "$b");
    }
    return undef;
}
sub semantic {
    my ($conf) = @_;
    my $copy = dclone($conf);
    delete $copy->{digest};
    return $copy;
}
sub same {
    my ($expected, $actual, $label) = @_;
    my $bad = difference(semantic($expected), semantic($actual), 'config');
    die "$label would change $bad\n" if defined($bad);
}
sub strict_config {
    my ($file, $raw) = @_;
    # Audit only constructs the native parser discards; native parsing owns meaning.
    my ($section, %headers, %singletons) = ('');
    for my $line (split /\n/, $raw) {
        next if $line =~ /^\s*$/ || $line =~ /^#/;
        if ($line =~ /^\[([^\]]+)\]\s*$/) {
            $section = lc($1) eq 'pve:pending' ? 'pve:pending' : $1;
            die "Duplicate config section $section\n" if $headers{$section}++;
        } elsif ($line =~ /snapstate:\s*(prepare|delete)\s*$/ && $section eq '') {
            die "Active snapstate cannot be preserved by the native parser\n";
        } elsif ($line =~ /^([a-z][a-z_]*\d*):/ && $1 ne 'description') {
            die "Duplicate setting $section/$1\n" if $singletons{$section}{$1}++;
        }
    }
    return PVE::LXC::Config::parse_pct_config($file, $raw, 1);
}
sub roundtrip {
    my ($file, $conf) = @_;
    my $copy = dclone($conf);
    my $raw = PVE::LXC::Config::write_pct_config($file, $copy);
    same($conf, $copy, 'Native serializer');
    same($conf, strict_config($file, $raw), 'Native roundtrip');
}
sub mount_key {
    my ($value) = @_;
    my @fields = split /\s+/, $value;
    return '' if @fields < 4;
    my $extra = join ' ', @fields[4 .. $#fields];
    return '' if @fields > 4 && $extra !~ /^0(?: 0)?$/;
    return join ' ', @fields[0 .. 2], join(',', sort split /,/, $fields[3]);
}

# Device-only model: LXC 5.0/6.0/7.0 cgroup2_devices.c has identical normalized
# bpf_device_add/list_add/append/finalize logic. No BPF program is loaded here.
my $policy_json = JSON::PP->new->canonical;
my (%policy_dependencies, @policy_directories);
my ($policy_bytes, $policy_nodes) = (0, 0);
my ($policy_work, $policy_where) = (0, 'policy');
sub policy_identity { return [@_[0, 1, 2, 3, 4, 5, 7, 9, 10]]; }
sub policy_snapshot {
    my ($path) = @_;
    my $inspect = $path; $inspect =~ s{/+$}{}; $inspect = '/' if $inspect eq '';
    my @link = lstat($inspect);
    if (!@link) {
        die "Cannot inspect policy dependency $path: $!\n" if !$!{ENOENT} && !$!{ENOTDIR};
        return { kind => 'missing', errno => 0 + $! };
    }
    my $out = { link => policy_identity(@link) };
    $out->{target} = readlink($inspect) if S_ISLNK($link[2]);
    my @st = stat($path);
    if (!@st) {
        die "Cannot inspect policy target $path: $!\n" if !$!{ENOENT} && !$!{ENOTDIR};
        $out->{kind} = 'missing'; $out->{errno} = 0 + $!;
        return $out;
    }
    $out->{stat} = policy_identity(@st);
    if (S_ISREG($st[2])) {
        die "Native read-only policy path pinning unavailable for $path\n" if !PVE::Tools->can('O_PATH');
        sysopen(my $pin, $path, PVE::Tools::O_PATH()) or die "Cannot pin policy dependency $path: $!\n";
        my @pinned = stat($pin);
        die "Policy dependency changed while pinning $path\n"
            if !S_ISREG($pinned[2]) || $policy_json->encode(policy_identity(@pinned)) ne $policy_json->encode($out->{stat});
        # Open only the pinned regular inode. A path swap cannot open a device/FIFO.
        sysopen(my $fh, '/proc/self/fd/' . fileno($pin), O_RDONLY | O_NONBLOCK)
            or die "Cannot read policy dependency $path: $!\n";
        binmode($fh);
        my @fd = stat($fh);
        die "Policy dependency changed while opening $path\n"
            if !S_ISREG($fd[2]) || $policy_json->encode(policy_identity(@fd)) ne $policy_json->encode($out->{stat});
        my $bytes = '';
        while (1) {
            my $n = read($fh, my $part, 65536);
            die "Cannot read policy dependency $path: $!\n" if !defined($n);
            last if !$n;
            $bytes .= $part;
            die "Policy dependency exceeds 2 MiB: $path\n" if length($bytes) > 2097152;
        }
        @fd = stat($fh);
        close($fh) or die "Cannot close policy dependency $path: $!\n";
        die "Policy dependency changed while reading $path\n"
            if $policy_json->encode(policy_identity(@fd)) ne $policy_json->encode($out->{stat});
        $out->{kind} = 'file'; $out->{bytes} = $bytes;
    } elsif (S_ISDIR($st[2])) {
        opendir(my $dir, $path) or die "Cannot read policy directory $path: $!\n";
        my @names = grep { $_ ne '.' && $_ ne '..' } readdir($dir);
        closedir($dir) or die "Cannot close policy directory $path: $!\n";
        $out->{kind} = 'directory';
        # Sort only the captured membership, never assume this is native load order.
        $out->{members} = [sort @names];
    } elsif (S_ISCHR($st[2]) || S_ISBLK($st[2])) {
        $out->{kind} = S_ISCHR($st[2]) ? 'c' : 'b';
        $out->{major} = PVE::Tools::dev_t_major($st[6]);
        $out->{minor} = PVE::Tools::dev_t_minor($st[6]);
    } else { $out->{kind} = 'special'; }
    my @now = stat($path); my @now_link = lstat($inspect);
    die "Policy dependency changed while inspecting $path\n"
        if !@now || !@now_link || $policy_json->encode(policy_identity(@now)) ne $policy_json->encode($out->{stat})
        || $policy_json->encode(policy_identity(@now_link)) ne $policy_json->encode($out->{link});
    return $out;
}
sub policy_dependency {
    my ($path) = @_;
    die "Uncharacterized relative/control-byte policy path: $path\n" if $path !~ m{^/} || $path =~ /[\0\r\n]/;
    my $snapshot = policy_snapshot($path);
    if (exists($policy_dependencies{$path})) {
        die "Policy dependency changed: $path\n"
            if $policy_json->encode($snapshot) ne $policy_json->encode($policy_dependencies{$path});
    } else {
        die "Too many policy dependencies at $path\n" if keys(%policy_dependencies) >= 512;
        $policy_bytes += length($snapshot->{bytes} // '');
        die "Policy closure exceeds 8 MiB at $path\n" if $policy_bytes > 8388608;
        $policy_dependencies{$path} = $snapshot;
    }
    return $snapshot;
}
sub policy_revalidate {
    for my $path (sort keys %policy_dependencies) {
        die "Policy dependency changed: $path\n"
            if $policy_json->encode(policy_snapshot($path)) ne $policy_json->encode($policy_dependencies{$path});
    }
}
sub policy_number {
    my ($value, $origin) = @_;
    return -1 if $value eq '*';
    # Native device parsing accepts digits, then lxc_safe_int uses strtol(base=0).
    # A leading zero is octal; hexadecimal never reaches safe_int from this parser.
    my $base = length($value) > 1 && substr($value, 0, 1) eq '0' ? 8 : 10;
    my $number = 0;
    for my $digit (split //, $value) {
        die "Invalid device number at $origin\n"
            if $digit >= $base || $number > int((2147483647 - $digit) / $base);
        $number = $number * $base + $digit;
    }
    return $number;
}
sub policy_rule {
    my ($key, $value, $origin) = @_;
    my $allow = $key eq 'lxc.cgroup2.devices.allow' ? 1 : 0;
    return { kind => 'rule', allow => $allow, type => 'a', major => -1, minor => -1,
             access => '', mask => 0, origin => $origin } if $value eq 'a';
    my ($type, $major, $minor, $access);
    if ($allow && $value =~ m{^(/[^ ]+) +([^ ]+)(?: .*)?$}) {
        my ($path, $mode) = ($1, $2);
        my $dep = policy_dependency($path);
        die "Device policy path is not a device at $origin: $path\n" if $dep->{kind} ne 'c' && $dep->{kind} ne 'b';
        ($type, $major, $minor) = @{$dep}{qw(kind major minor)};
        die "Invalid device access at $origin\n" if $mode !~ /^([rwm]{1,3})/;
        $access = $1;
        die "Invalid device access at $origin\n" if length($access) < 3 && $mode ne $access;
    } elsif ($value =~ /^([abc])[ \t\r\f\x0b]([0-9]{1,49}|\*):([0-9]{1,49}|\*)[ \t\r\f\x0b]([rwm]{1,3})(.*)$/s) {
        my $tail;
        ($type, $major, $minor, $access, $tail) = ($1, $2, $3, $4, $5);
        die "Invalid device access at $origin\n" if length($access) < 3 && $tail ne '';
        $major = policy_number($major, $origin); $minor = policy_number($minor, $origin);
    } else { die "Invalid or unsupported device rule at $origin\n"; }
    my $mask = 0;
    for my $c (split //, $access) { $mask |= { r => 2, w => 4, m => 1 }->{$c}; }
    return { kind => 'rule', allow => $allow, type => $type, major => $major, minor => $minor,
             access => $access, mask => $mask, origin => $origin };
}
sub policy_include;
sub policy_directive {
    my ($key, $value, $origin, $stack) = @_;
    $value =~ s/^[ \t]+|[ \t]+$//g;
    $value = substr($value, 1, length($value) - 2)
        if length($value) >= 2 && (substr($value, 0, 1) eq q(') || substr($value, 0, 1) eq q("))
        && substr($value, -1) eq substr($value, 0, 1);
    return policy_include($value, $stack) if $key eq 'lxc.include' && length($value);
    return [] if $key eq 'lxc.include'; # Native include clearing does not undo parsed settings.
    if ($key eq 'lxc.cgroup2' || $key =~ /^lxc\.cgroup2\.devices/) {
        return [{ kind => 'clear', controller => $key, origin => $origin }] if $value eq '';
        die "Invalid nonempty lxc.cgroup2 at $origin\n" if $key eq 'lxc.cgroup2';
        # Native confile first stores opaque controller values. Empty-controller
        # directives remove previous entries before device-rule preparation.
        return [{ kind => 'raw', controller => $key, value => $value,
                  allow => $key eq 'lxc.cgroup2.devices.allow' ? 1 : 0, origin => $origin }];
    }
    return []; # Unrelated LXC directives remain native-owner data, not a new parser.
}
sub policy_include {
    my ($path, $stack) = @_;
    die "Policy include nesting exceeds 32 at $path\n" if @$stack >= 32;
    my $dep = policy_dependency($path);
    # Native do_includedir treats ENOENT as an empty optional directory. A missing
    # file or ENOTDIR is still an error; the absent directory remains a dependency.
    return [] if $path =~ m{/$} && $dep->{kind} eq 'missing' && $dep->{errno} == ENOENT;
    die "Unreadable/missing/special policy include: $path\n" if $dep->{kind} ne 'file' && $dep->{kind} ne 'directory';
    my $id = join(':', $dep->{kind}, @{$dep->{stat}}[0, 1]);
    die "Policy include cycle at $path\n" if grep { $_ eq $id } @$stack;
    my @next = (@$stack, $id);
    if ($dep->{kind} eq 'directory') {
        my @files;
        for my $name (@{$dep->{members}}) {
            next if length($name) < 6 || $name !~ /\.conf$/;
            die "Policy directory member is not a regular config file: $path/$name\n"
                if policy_dependency("$path/$name")->{kind} ne 'file';
            my $ops = policy_include("$path/$name", \@next);
            push @files, { path => "$path/$name", ops => $ops } if @$ops;
        }
        return [] if !@files;
        return $files[0]->{ops} if @files == 1;
        push @policy_directories, $path;
        return [{ kind => 'directory', path => $path, files => \@files }];
    }
    # LXC 5/6/7 parse.c lxc_file_for_each_line_mmap uses strtok_r on CR/LF:
    # its first NUL terminates the buffer. confile.c parse_line trims space/tab
    # only (string_utils.c lxc_char_left_gc/right_gc), never VT or form-feed.
    my $text = $dep->{bytes}; $text =~ s/\0.*\z//s;
    my @ops; my $line_number = 0;
    for my $line (split /[\r\n]+/, $text) {
        ++$line_number; $line =~ s/^[ \t]+|[ \t]+$//g;
        next if $line eq '' || $line =~ /^#/ || $line !~ /^lxc\./;
        die "Invalid LXC dependency line at $path:$line_number\n" if $line !~ /^([^=]+)=(.*)$/s;
        my ($key, $value) = ($1, $2); $key =~ s/[ \t]+$//;
        push @ops, @{policy_directive($key, $value, "$path:$line_number", \@next)};
        die "Policy closure has too many directives at $path\n" if ++$policy_nodes > 8192;
    }
    return \@ops;
}
sub policy_commutes {
    my ($files) = @_;
    my %keys;
    my @plain;
    for my $file (@$files) {
        my @ops;
        for my $op (@{$file->{ops}}) {
            if ($op->{kind} eq 'rule') { push @ops, $op; next; }
            return 0 if $op->{kind} ne 'raw' || $op->{value} =~ m{^/}
                || ($op->{controller} ne 'lxc.cgroup2.devices.allow' && $op->{controller} ne 'lxc.cgroup2.devices.deny');
            my $rule = eval { policy_rule($op->{controller}, $op->{value}, $op->{origin}) };
            return 0 if !$rule;
            push @ops, $rule;
        }
        push @plain, { ops => \@ops };
    }
    $files = \@plain;
    my @globals = map { @{$_->{ops}} == 1 && $_->{ops}[0]{kind} eq 'rule'
        && $_->{ops}[0]{access} eq '' ? $_->{ops}[0]{allow} : -1 } @$files;
    return 1 if $globals[0] >= 0 && !grep { $_ != $globals[0] } @globals;
    for my $index (0 .. $#$files) {
        my $ops = $files->[$index]->{ops};
        for my $op (@$ops) {
            return 0 if $op->{kind} ne 'rule' || $op->{access} eq '';
            my $key = join(':', @{$op}{qw(type major minor access)});
            for my $other (keys %{$keys{$key} // {}}) {
                next if $other == $index;
                return 0 if grep { $_ != $op->{allow} } keys %{$keys{$key}{$other}};
            }
            $keys{$key}{$index}{$op->{allow}} = 1;
        }
    }
    return 1;
}
sub policy_orders {
    my ($files) = @_;
    return [[]] if !@$files;
    my @orders;
    for my $i (0 .. $#$files) {
        my @rest = @$files; my $first = splice(@rest, $i, 1);
        push @orders, map { [$first, @$_] } @{policy_orders(\@rest)};
    }
    return \@orders;
}
sub policy_expand {
    my ($ops, $states) = @_;
    for my $op (@$ops) {
        if ($op->{kind} eq 'directory') {
            die "Uncharacterized policy directory order (>6 policy files): $op->{path}\n"
                if @{$op->{files}} > 6 && !policy_commutes($op->{files});
            my $orders = policy_commutes($op->{files}) ? [$op->{files}] : policy_orders($op->{files});
            my @next;
            for my $state (@$states) {
                for my $order (@$orders) {
                    my $branch = [ [@$state] ];
                    for my $file (@$order) { $branch = policy_expand($file->{ops}, $branch); }
                    push @next, @$branch;
                    die "Uncharacterized policy order complexity at $op->{path}\n" if @next > 4096;
                }
            }
            $states = \@next;
        } elsif ($op->{kind} eq 'clear') {
            my $which = $op->{controller};
            $states = [map { [grep { $which ne 'lxc.cgroup2' &&
                ($_->{controller} // ($_->{allow} ? 'lxc.cgroup2.devices.allow' : 'lxc.cgroup2.devices.deny')) ne $which } @$_] } @$states];
        } else { $states = [map { [@$_, $op] } @$states]; }
        my $cells = 0; $cells += @$_ for @$states;
        die "Policy expansion budget exceeded at " . ($op->{path} // $op->{origin}) . "\n" if $cells > 262144;
    }
    return $states;
}
sub policy_access {
    my ($state, $tuple, $request) = @_;
    # cgfsng.c cgfsng_devices_activate (LXC 7:2972-2976; 6:3551; 5:2886)
    # attaches no additional program when the WHOLE native list is empty.
    # Ineffectual entries still make that list nonempty and activate its default.
    return 1 if !@{$state->{devices}};
    for my $rule (@{$state->{devices}}) {
        die "Device-policy evaluation budget exceeded at $policy_where\n" if ++$policy_work > 2000000;
        next if $rule->{allow} == $state->{mode}; # Native skips rules opposite to the selected program type.
        next if $rule->{type} ne 'a' && $rule->{type} ne ($tuple->[2] // 'c');
        next if $rule->{major} >= 0 && $rule->{major} != $tuple->[0];
        next if $rule->{minor} >= 0 && $rule->{minor} != $tuple->[1];
        return $rule->{allow} if ($request & $rule->{mask}) == $request;
    }
    return $state->{mode}; # Characterized native initializer/default: allowlist=0, denylist=1.
}
sub policy_apply {
    my ($state, $rule) = @_;
    if ($rule->{access} eq '') { $state->{mode} = $rule->{allow}; $state->{devices} = []; return; }
    for my $old (@{$state->{devices}}) {
        next if $old->{type} ne $rule->{type} || $old->{major} != $rule->{major} || $old->{minor} != $rule->{minor}
            || $old->{access} ne $rule->{access} || $old->{allow} == $state->{mode};
        $old->{allow} = $rule->{allow}; return;
    }
    unshift @{$state->{devices}}, { %$rule };
}
sub policy_replay {
    my ($stream, $representatives) = @_;
    my $state = { mode => 0, devices => [], blocked => {} };
    for my $rule (@$stream) {
        $policy_where = $rule->{origin};
        my $was_active = @{$state->{devices}} ? 1 : 0;
        my @before = map { my $t = $_; [map { policy_access($state, $t, $_) } 1 .. 7] } @$representatives;
        policy_apply($state, $rule);
        if ($rule->{access} eq '') { $state->{blocked} = {}; next; }
        for my $i (0 .. $#$representatives) {
            for my $mask (1 .. 7) {
                my $key = join(':', @{$representatives->[$i]}, $mask);
                my $now = policy_access($state, $representatives->[$i], $mask);
                delete $state->{blocked}{$key} if $now;
                $state->{blocked}{$key} = $rule->{origin} if $was_active && !$rule->{allow} && $before[$i][$mask - 1] && !$now;
            }
        }
    }
    return $state;
}
sub policy_canonical {
    my ($state) = @_;
    my %rules = map { join(':', @{$_}{qw(type major minor mask)}) => 1 }
        grep { $_->{allow} != $state->{mode} } @{$state->{devices}};
    # Empty/nonempty changes decisions only in allowlist mode. A denylist with
    # only ineffectual allows permits everything, just like no attached program.
    return $policy_json->encode([$state->{mode}, !$state->{mode} && @{$state->{devices}} ? 1 : 0, sort keys %rules]);
}
sub policy_view {
    my ($conf) = @_;
    my ($major) = PVE::LXC::get_lxc_version();
    die "Uncharacterized LXC device-policy version\n" if !defined($major) || $major !~ /^[567]$/;
    my (undef, $unified) = PVE::CGroup::get_cgroup_controllers();
    die "Unified cgroup policy is unavailable\n" if !defined($unified);
    my $ostype = $conf->{ostype} // die "Missing PVE OS type for policy prelude\n";
    die "Uncharacterized PVE OS policy type\n" if $ostype !~ /^[a-z][a-z0-9-]*$/;
    my $include = "/usr/share/lxc/config/$ostype.common.conf";
    $include = '/usr/share/lxc/config/common.conf' if policy_dependency($include)->{kind} ne 'file';
    my @ops = @{policy_include($include, [])};
    # Generated devN chunks commute: their allow access is r/rw and deny access w,
    # hence no opposite exact keys across chunks. Do not assume native hash order.
    my @readonly;
    for my $key (keys %$conf) {
        next if $key !~ /^dev[0-9]+$/;
        die "Missing native device parser for $key\n" if !PVE::LXC::Config->can('parse_device');
        my $device = PVE::LXC::Config->parse_device($conf->{$key});
        my $path = $device->{path} // die "Missing generated device path for $key\n";
        my $dep = policy_dependency($path);
        die "Generated policy path is not a device: $path\n" if $dep->{kind} ne 'c' && $dep->{kind} ne 'b';
        my $type = $dep->{kind}; my $numbers = "$dep->{major}:$dep->{minor}";
        push @readonly, { tuple => [$dep->{major}, $dep->{minor}, $type], origin => "PVE $key deny-write" }
            if $device->{'deny-write'};
        push @ops, policy_rule('lxc.cgroup2.devices.allow', "$type $numbers " . ($device->{'deny-write'} ? 'r' : 'rw'), "PVE $key");
        push @ops, policy_rule('lxc.cgroup2.devices.deny', "$type $numbers w", "PVE $key") if $device->{'deny-write'};
    }
    push @ops, policy_rule('lxc.cgroup2.devices.deny', 'c 5:1 rwm', 'PVE console') if !PVE::LXC::Config->has_dev_console($conf);
    my $index = 0;
    for my $pair (@{$conf->{lxc} // []}) {
        die "Control byte in rendered active LXC directive at pair $index\n"
            if grep { /[\0\r\n]/ } @$pair;
        push @ops, @{policy_directive(@$pair, 'active lxc pair ' . $index++, [])};
    }
    my $streams = policy_expand(\@ops, [[]]);
    $streams = [map { [map {
        if ($_->{kind} eq 'raw') {
            die "Unsupported device controller $_->{controller} at $_->{origin}\n"
                if $_->{controller} ne 'lxc.cgroup2.devices.allow' && $_->{controller} ne 'lxc.cgroup2.devices.deny';
            policy_rule($_->{controller}, $_->{value}, $_->{origin});
        } else { $_; }
    } @$_] } @$streams];
    my %majors = map { $_->[0] => 1 } @required;
    my %minors;
    for my $stream (@$streams) {
        for my $rule (@$stream) {
            next if $rule->{type} eq 'b' || $rule->{minor} < 0 || $rule->{minor} > 1048575;
            for my $m (keys %majors) { $minors{$m}{$rule->{minor}} = 1 if $rule->{major} < 0 || $rule->{major} == $m; }
        }
    }
    for my $tuple (@required) { $minors{$tuple->[0]}{$tuple->[1]} = 1; }
    my @representatives;
    for my $m (sort { $a <=> $b } keys %majors) {
        my $other = 0; ++$other while $other <= 1048575 && $minors{$m}{$other};
        $minors{$m}{$other} = 1 if $other <= 1048575;
        push @representatives, map { [$m, 0 + $_] } keys %{$minors{$m}};
    }
    my @states = map { policy_replay($_, \@representatives) } @$streams;
    my $canonical = policy_canonical($states[0]);
    die 'Order-dependent policy include directory: ' . join(', ', @policy_directories) . "\n"
        if grep { policy_canonical($_) ne $canonical } @states;
    return { states => \@states, representatives => \@representatives, readonly => \@readonly };
}
sub policy_granted {
    my ($view, $major) = @_;
    for my $state (@{$view->{states}}) {
        for my $tuple (@required) {
            next if defined($major) && $tuple->[0] != $major;
            for my $mask (1 .. 7) { return 0 if !policy_access($state, $tuple, $mask); }
        }
    }
    return 1;
}
sub policy_preserve_denials {
    my ($before, $after) = @_;
    # Structured devN deny-write is explicit foreign intent, including when the
    # native allowlist withholds write by omission instead of an effective deny.
    # Compare actual configured rights: preexisting write is not a new relaxation.
    for my $constraint (@{$before->{readonly}}) {
        for my $state (@{$before->{states}}) {
            for my $mask (4 .. 7) {
                next if policy_access($state, $constraint->{tuple}, $mask);
                for my $candidate (@{$after->{states}}) {
                    die "Structured deny-write would be relaxed ($constraint->{origin})\n"
                        if policy_access($candidate, $constraint->{tuple}, $mask);
                }
            }
        }
    }
    for my $state (@{$before->{states}}) {
        for my $key (keys %{$state->{blocked}}) {
            my ($major, $minor, $mask) = split /:/, $key;
            for my $candidate (@{$after->{states}}) {
                die "Foreign denial would be neutralized for c $major:$minor access $mask ($state->{blocked}{$key})\n"
                    if policy_access($candidate, [$major, $minor], $mask);
            }
        }
    }
}
eval {
    PVE::LXC::Config->lock_config($ctid, sub {
        PVE::Cluster::cfs_update(1);
        my $file = '/etc/pve/' . PVE::LXC::Config->cfs_config_path($ctid);
        my $raw = PVE::Tools::file_get_contents($file);
        my $conf = strict_config($file, $raw);
        my $loaded = PVE::LXC::Config->load_config($ctid);
        die "CFS/raw config digest mismatch\n" if $loaded->{digest} ne $conf->{digest};
        same($conf, $loaded, 'CFS load');
        PVE::LXC::Config->check_lock($conf);
        die "NVIDIA passthrough supports only privileged CTs\n"
            if $conf->{unprivileged} || PVE::LXC::Config->has_lxc_entry($conf, 'lxc.idmap');
        roundtrip($file, $conf);
        for my $path (keys %required_nodes) {
            my $dep = policy_dependency($path);
            die "Required NVIDIA device metadata changed: $path\n"
                if $dep->{kind} ne 'c' || $dep->{major} != $required_nodes{$path}[0] || $dep->{minor} != $required_nodes{$path}[1];
        }
        my $original_policy = policy_view($conf);
        die "Foreign denylist blocks required NVIDIA character access\n"
            if $original_policy->{states}[0]->{mode} && !policy_granted($original_policy, undef);
        my $candidate = dclone($conf);
        my $changed = 0;
        for my $want (@wanted) {
            my ($key, $value) = @$want;
            if ($key eq 'lxc.cgroup2.devices.allow') {
                my ($major) = $value =~ /^c ([0-9]+):/;
                my $view = policy_view($candidate);
                next if policy_granted($view, $major);
                push @{$candidate->{lxc}}, $want; $changed = 1;
                next;
            }
            my $found = 0;
            for my $old (@{$candidate->{lxc} // []}) {
                next if $old->[0] ne $key;
                if ($key eq 'lxc.mount.entry') {
                    my @a = split /\s+/, $old->[1];
                    my @b = split /\s+/, $value;
                    die "Noncanonical mount destination $a[1] conflicts with $b[1]\n"
                        if @a >= 2 && ($a[1] eq "/$b[1]" || $a[1] eq "./$b[1]");
                    next if @a < 2 || $a[1] ne $b[1];
                    die "Conflicting mount destination $b[1]\n" if mount_key($old->[1]) ne mount_key($value);
                    $found = 1;
                } else {
                    my $normalized = $old->[1];
                    $normalized =~ s/\s+/ /g;
                    $normalized =~ s/^ | $//g;
                    if ($normalized =~ /^c ([0-9]{1,10}):\* ([rwm]+)$/) {
                        my ($major, $permissions) = (0 + $1, $2);
                        my %permissions = map { $_ => 1 } split //, $permissions;
                        $normalized = "c $major:* " . join('', grep { $permissions{$_} } qw(r w m));
                    }
                    $found = 1 if $normalized eq $value;
                }
            }
            if (!$found) { push @{$candidate->{lxc}}, $want; $changed = 1; }
        }
        roundtrip($file, $candidate);
        my $candidate_policy = policy_view($candidate);
        die "Candidate does not grant required configured NVIDIA character access\n" if !policy_granted($candidate_policy, undef);
        policy_preserve_denials($original_policy, $candidate_policy);
        die "Config changed before publication\n" if PVE::Tools::file_get_contents($file) ne $raw;
        policy_revalidate();
        if ($changed) {
            $attempted = 1;
            PVE::LXC::Config->write_config($ctid, dclone($candidate));
        }
        PVE::Cluster::cfs_update(1);
        policy_revalidate();
        my $readback = strict_config($file, PVE::Tools::file_get_contents($file));
        same($candidate, $readback, 'Config readback');
        $loaded = PVE::LXC::Config->load_config($ctid);
        die "CFS readback digest mismatch\n" if $loaded->{digest} ne $readback->{digest};
        same($candidate, $loaded, 'CFS readback');
    });
    1;
} or do {
    my $error = $@ || "Unknown native config error\n";
    die "NVIDIA CT $ctid: " . ($attempted ? 'publication/readback failed; config may have changed: ' : 'not published: ') . $error;
};
PERL
}
